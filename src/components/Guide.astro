---
// A guide for search (the rules, how to play) in the app's one-screen way: a large title, a row of tabs, and short
// cards that page sideways. Every word is in the HTML, so a search engine reads the whole guide; on a phone it reads
// like the rest of the app.
import { icon } from '../lib/icons';
import { miniBoard } from '../lib/miniboard';

export interface Section {
  tab: string;
  title: string;
  /** a few short paragraphs (plain text; [label](href) makes a link) */
  text: string[];
  fen?: string;
  side?: 'w' | 'b';
  marks?: string[];
  /** what the diagram shows, read aloud */
  label?: string;
  links?: { href: string; label: string; solid?: boolean }[];
}
interface Props {
  name: string;
  title: string;
  sub: string;
  sections: Section[];
}
const { name, title, sub, sections } = Astro.props;
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const rich = (s: string) => esc(s).replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
---

<div class="screen screen--split guide">
  <header class="screen__head">
    <div>
      <h1 class="screen__title poster">{title}</h1>
      <p class="screen__sub">{sub}</p>
    </div>
  </header>

  <div class="pager-tabs" role="tablist" aria-label={title} data-pager-tabs={name}>
    {sections.map((s, i) => <button type="button" role="tab" data-pager-tab={i} aria-controls={`${name}-${i}`}><span class="tab__n">{i + 1}</span>{s.tab}</button>)}
  </div>

  <div class="pager" data-pager={name}>
    {sections.map((s, i) => (
      <section class="pager__page" role="tabpanel" id={`${name}-${i}`} aria-labelledby={`${name}-${i}-h`}>
        <article class="card glass-card stagger" data-fen={s.fen ? '' : undefined}>
          <h2 class="card__h" id={`${name}-${i}-h`} style="--i: 0">{s.title}</h2>
          <div class="card__text" style="--i: 1">
            {s.text.map((t) => <p set:html={rich(t)} />)}
          </div>
          {s.fen && <div class="card__board" style="--i: 2" set:html={miniBoard(s.fen, { side: s.side ?? 'w', marks: s.marks ?? [], label: s.label })} />}
          {s.links && (
            <div class="card__links" style="--i: 3">
              {s.links.map((l) => (
                <a class:list={['btn', l.solid && 'btn--solid']} href={l.href}>{l.label}<Fragment set:html={icon('caretRight')} /></a>
              ))}
            </div>
          )}
        </article>
      </section>
    ))}
  </div>
</div>

<style>
  .guide { grid-template-rows: auto minmax(0, 1fr); }
  .guide .tab__n { min-width: 1.25rem; font-family: var(--font-display); font-weight: 600; color: #e2c48c; text-align: center; }
  :global(html[data-world-tone='light']) .guide .tab__n { color: #8a5a22; }
  /* one card per page: the title, a few lines, the diagram taking what is left */
  .card { display: flex; flex-direction: column; gap: 0.625rem; height: 100%; padding: 1rem 1rem 0.875rem; border-radius: 1.5rem; overflow: hidden; }
  .card > * { flex: none; }
  .card__h { font-family: var(--font-display); font-size: var(--t-title1); font-weight: 600; line-height: 1.08; letter-spacing: -0.01em; }
  .card__text { display: grid; gap: 0.5rem; font-size: var(--t-sub); line-height: 1.42; color: var(--label); max-width: 62ch; }
  .card__text :global(a) { color: var(--tint-ink); font-weight: 600; text-decoration: none; }
  /* the diagram takes the room left, square, never past it */
  .card__board { flex: 1 1 auto !important; min-height: 0; display: grid; place-items: center; container-type: size; }
  .card__board :global(.mini) { width: min(100cqw, 100cqh - 0.5rem, 18rem); height: auto; }
  .card__links { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: auto; }
  .card__links .btn { min-height: 44px; padding-inline: 1rem; gap: 0.25rem; }
  .card__links :global(.icon) { width: 0.875rem; height: 0.875rem; }
  /* a short phone keeps the words and lets the diagram go */
  @media (max-height: 700px) { .card__board { display: none; } .card__h { font-size: var(--t-title2); } }
  /* a very short one sets them a little closer, and the buttons keep one row */
  @media (max-height: 640px) {
    .card { gap: 0.5rem; padding: 0.75rem 0.875rem; }
    .card__text { gap: 0.375rem; font-size: calc(var(--t-sub) - 1px); line-height: 1.36; }
    .card__links { flex-wrap: nowrap; }
    .card__links .btn { font-size: 0.9375rem; padding-inline: 0.75rem; }
    /* larger text on the smallest phones: the guide's words stay at the normal 15px so a card still fits */
    :global(html[data-text='large']) .card__text { font-size: 0.9375rem; }
  }
  @media (min-width: 1024px) {
    .card { padding: 1.5rem 1.75rem; }
    .card__text { font-size: var(--t-body); }
    .card__board :global(.mini) { width: min(100cqw, 100cqh - 0.5rem, 22rem); }
  }
</style>
