---
import App from '../layouts/App.astro';
import { icon } from '../lib/icons';
import { THEMES } from '../lib/themes';
import '../styles/play.css';
---

<App title="Ushtrime · Shah" description="Ushtrime taktike nga baza e Lichess: pirun, lidhje, mat në një dhe në dy lëvizje." tab="ushtrime" stage>
  <h1 class="visually-hidden">Ushtrime</h1>
  <div class="stage" data-stage-box>
    <div class="board" data-board tabindex="0" role="application" aria-label="Tabela e ushtrimit. Shigjetat lëvizin kursorin, Enter zgjedh figurën dhe e lëviz.">
      <div class="promo" data-promo data-board-ui hidden role="group" aria-label="Ushtari bëhet">
        <button type="button" data-piece="q"><svg aria-hidden="true"><use href="#pc-w-q"></use></svg><span>Mbretëreshë</span></button>
        <button type="button" data-piece="r"><svg aria-hidden="true"><use href="#pc-w-r"></use></svg><span>Torrë</span></button>
        <button type="button" data-piece="b"><svg aria-hidden="true"><use href="#pc-w-b"></use></svg><span>Oficer</span></button>
        <button type="button" data-piece="n"><svg aria-hidden="true"><use href="#pc-w-n"></use></svg><span>Kalë</span></button>
        <button type="button" data-piece="x" class="promo__cancel" aria-label="Anulo"><Fragment set:html={icon('x')} /></button>
      </div>
    </div>

    <div class="bug bug--live" data-board-ui>
      <span class="bug__live">Ushtrim</span>
      <span class="bug__status" data-status>Po përgatitet…</span>
    </div>

    <div class="bug bug--score" data-board-ui>
      <div class="score__row"><button type="button" class="score__name score__pick" data-theme-name data-panel-open="themes" aria-label="Zgjidh temën">Tema</button><span class="tabular" data-puzzle-rating></span></div>
      <div class="score__row"><span class="score__name" data-my-label>Vlerësimi yt</span><span class="score__flame" data-flame hidden><Fragment set:html={icon('fire')} /></span><b class="tabular" data-my-rating></b></div>
    </div>

    <div class="tools" data-board-ui>
      <button type="button" class="tool tool--menu" data-tools-toggle aria-expanded="false" aria-controls="tools-list" aria-label="Mjetet"><Fragment set:html={icon('dotsThreeVertical')} /></button>
      <div class="tools__list" id="tools-list">
        <button type="button" class="tool" data-next-puzzle><span class="tool__icon"><Fragment set:html={icon('arrowRight')} /></span><span class="tool__label" data-label>Ushtrimi tjetër</span></button>
        <button type="button" class="tool" data-panel-open="themes"><span class="tool__icon"><Fragment set:html={icon('puzzlePiece')} /></span><span class="tool__label">Tema dhe mënyrat</span></button>
        <button type="button" class="tool" data-angle><span class="tool__icon"><Fragment set:html={icon('videoCamera')} /></span><span class="tool__label" data-label>Këndi i kamerës</span></button>
        <button type="button" class="tool" data-look-open><span class="tool__icon"><Fragment set:html={icon('palette')} /></span><span class="tool__label">Pamja</span></button>
        <button type="button" class="tool tool--motion" data-motion-switch aria-pressed="false"><span class="tool__icon" data-when="on"><Fragment set:html={icon('pause')} /></span><span class="tool__icon" data-when="off"><Fragment set:html={icon('play')} /></span><span class="tool__label">Ndal animacionet</span></button>
      </div>
    </div>

    <section class="lower" data-coach data-state="intro" aria-labelledby="coach-title" data-board-ui>
      <div class="lower__head">
        <h2 class="lower__tag" id="coach-title">Trajneri</h2>
        <div class="lower__headline">
          <p class="lower__glyph poster" data-glyph>Gjej lëvizjen</p>
          <p class="lower__title" data-title></p>
        </div>
      </div>
      <div class="lower__body">
        <ul class="lower__reasons" data-reasons></ul>
        <div class="lower__actions">
          <button type="button" class="cue" data-hint><Fragment set:html={icon('lightbulb')} />Ndihmë</button>
          <button type="button" class="cue" data-solution><Fragment set:html={icon('eye')} />Zgjidhja</button>
          <button type="button" class="cue cue--on" data-next hidden><Fragment set:html={icon('arrowRight')} />Tjetri</button>
          <button type="button" class="cue" data-again hidden><Fragment set:html={icon('arrowCounterClockwise')} />Provo përsëri</button>
          <button type="button" class="cue" data-share hidden><Fragment set:html={icon('shareNetwork')} />Ndaje</button>
        </div>
      </div>
      <p class="visually-hidden" aria-live="polite" data-live></p>
    </section>

    <div class="ticker" data-board-ui aria-hidden="true">
      <div class="ticker__rail"></div>
      <div class="ticker__band"><div class="ticker__track" data-ticker></div></div>
    </div>
  </div>

  <dialog class="setup panel" data-panel="themes" aria-labelledby="themes-panel-title">
    <div class="panel__head">
      <h2 class="panel__title" id="themes-panel-title" tabindex="-1">Ushtrimet</h2>
      <button type="button" class="panel__close" data-panel-close aria-label="Mbyll"><Fragment set:html={icon('x')} /></button>
    </div>
    <div class="panel__body">
    <h3 class="visually-hidden">Mënyrat</h3>
    <div class="group modes">
      <button type="button" class="row mode" data-daily>
        <span class="mode__tile mode__tile--day" aria-hidden="true"><Fragment set:html={icon('fire')} /></span>
        <span class="mode__body"><b>Ushtrimi i ditës</b><span data-daily-line>Një ushtrim i ri çdo ditë.</span></span>
        <span aria-hidden="true"><Fragment set:html={icon('caretRight', 'icon chev')} /></span>
      </button>
      <button type="button" class="row mode" data-rush>
        <span class="mode__tile mode__tile--rush" aria-hidden="true"><Fragment set:html={icon('lightning')} /></span>
        <span class="mode__body"><b>Gara 3 minutëshe</b><span data-rush-best>Sa ushtrime zgjidh në 3 minuta?</span></span>
        <span aria-hidden="true"><Fragment set:html={icon('caretRight', 'icon chev')} /></span>
      </button>
      <button type="button" class="row mode" data-contest-new hidden>
        <span class="mode__tile mode__tile--friends" aria-hidden="true"><Fragment set:html={icon('users')} /></span>
        <span class="mode__body"><b>Sfidë me shokët</b><span>Dhjetë ushtrime, të njëjtat për të gjithë. Kush zgjidh më shumë?</span></span>
        <span aria-hidden="true"><Fragment set:html={icon('caretRight', 'icon chev')} /></span>
      </button>
    </div>
    <h3 class="group-h themes-h" id="themes-title">Zgjidh temën</h3>
    <p class="record__opening">Ushtrimet vijnë nga baza e hapur e Lichess (CC0), me vlerësime nga lojtarë të vërtetë. Zgjidhja e çdonjërit është kontrolluar me motorin.</p>
    <div class="themes" data-themes role="radiogroup" aria-label="Tema">
      <label class="theme"><input type="radio" name="theme" value="mine" /><span><b>Gabimet e tua</b><span data-count="mine"></span></span></label>
      <label class="theme"><input type="radio" name="theme" value="all" checked /><span><b>Të gjitha</b><span data-count="all"></span></span></label>
      {THEMES.map((t) => (
        <label class="theme"><input type="radio" name="theme" value={t.id} /><span><b>{t.name}</b><span data-count={t.id}></span></span></label>
      ))}
    </div>
    </div>
  </dialog>
  <!-- a challenge between friends: ten puzzles, the same for all, and a board of results -->
  <dialog class="setup panel" data-panel="contest" aria-labelledby="contest-title">
    <div class="panel__head">
      <h2 class="panel__title" id="contest-title" tabindex="-1">Sfida</h2>
      <button type="button" class="panel__close" data-panel-close aria-label="Mbyll"><Fragment set:html={icon('x')} /></button>
    </div>
    <div class="panel__body contest">
      <p class="contest__lede" data-contest-lede>Dhjetë ushtrime rreth nivelit tënd. Shokët që hapin lidhjen zgjidhin të njëjtat, dhe tabela tregon kush zgjidhi më shumë e më shpejt. Pa ndihmë: një gabim e kalon ushtrimin.</p>
      <label class="contest__name">
        <span>Emri yt</span>
        <input type="text" maxlength="20" autocomplete="nickname" spellcheck="false" data-contest-name placeholder="Si të të shohin shokët" />
      </label>
      <p class="contest__err" data-contest-err role="alert" hidden></p>
      <div class="contest__actions">
        <button type="button" class="btn btn--solid" data-contest-go>Krijo sfidën</button>
        <button type="button" class="btn" data-contest-invite hidden><Fragment set:html={icon('shareNetwork')} />Fto shokët</button>
      </div>
      <h3 class="group-h" data-contest-board-h hidden>Tabela</h3>
      <ol class="group contest__board" data-contest-board hidden></ol>
      <p class="group-note" data-contest-ends hidden></p>
    </div>
  </dialog>
  <script>
    import '../scripts/puzzles';
  </script>
</App>

<style>
  .modes { margin-bottom: var(--space-l); }
  .modes > button + button { box-shadow: inset 4.125rem 0 0 var(--cell), inset 0 0.5px 0 var(--sep); }
  .mode { grid-template-columns: 2.25rem minmax(0, 1fr) auto; gap: 0.875rem; width: 100%; text-align: start; padding-block: 0.75rem; }
  .mode__tile { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 0.625rem; color: #fff; }
  .mode__tile .icon { width: 1.25rem; height: 1.25rem; }
  .mode__tile--day { background: linear-gradient(180deg, #ff9f0a, #ff6a00); }
  .mode__tile--rush { background: linear-gradient(180deg, #0a84ff, #0062d6); }
  .mode__tile--friends { background: linear-gradient(180deg, #30d158, #1f9e43); }
  .mode[hidden] { display: none; }
  /* the challenge sheet: a name, one action, the board of results */
  .contest { display: grid; gap: var(--space-s); align-content: start; }
  .contest__lede { font-size: var(--t-sub); line-height: 1.4; color: var(--label-2); padding-inline: 0.25rem; }
  .contest__name { display: grid; gap: 0.375rem; padding-inline: 0.25rem; }
  .contest__name > span { font-size: var(--t-foot); font-weight: 600; color: var(--label-2); }
  .contest__name input { min-height: 48px; padding: 0 1rem; border-radius: 0.875rem; border: 0; background: var(--fill-2); color: var(--label); font: inherit; font-size: 1rem; }
  .contest__name input:focus-visible { outline: 3px solid color-mix(in srgb, var(--tint) 75%, transparent); outline-offset: 1px; }
  .contest__err { color: var(--red-ink); font-size: var(--t-foot); font-weight: 600; padding-inline: 0.25rem; }
  .contest__err[hidden], .contest__board[hidden], [data-contest-board-h][hidden], [data-contest-ends][hidden], .contest__actions .btn[hidden] { display: none; }
  .contest__actions { display: grid; gap: 0.5rem; }
  .contest__board :global(li) { display: grid; grid-template-columns: 1.75rem minmax(0, 1fr) auto; align-items: center; gap: 0.625rem; min-height: 2.875rem; padding: 0.5rem 1rem; }
  .contest__board :global(li + li) { box-shadow: inset 1rem 0 0 var(--cell), inset 0 0.5px 0 var(--sep); }
  .contest__board :global(.rank) { font-family: var(--font-display); font-size: var(--t-title3); font-weight: 600; color: var(--label-2); text-align: center; }
  .contest__board :global(li:first-child .rank) { color: #d9b26f; }
  .contest__board :global(.who) { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }
  .contest__board :global(.res) { font-variant-numeric: tabular-nums; color: var(--label-2); font-size: var(--t-foot); }
  .contest__board :global(.res b) { color: var(--label); font-size: var(--t-sub); }
  .contest__board :global(li[data-me]) { background: color-mix(in srgb, var(--tint) 12%, transparent); }
  .mode__body { display: grid; gap: 0.0625rem; }
  .mode__body b { font-weight: 600; }
  .mode__body span { font-size: var(--t-foot); color: var(--label-2); }
  .themes { display: grid; margin-top: var(--space-s); background: var(--cell); border-radius: var(--r-list); overflow: hidden; }
  .theme {
    position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 1.25rem; gap: 0.75rem; align-items: center;
    min-height: 3.25rem; padding: 0.625rem 1rem; cursor: pointer; transition: background-color 120ms ease;
  }
  .theme + .theme { box-shadow: inset 1rem 0 0 var(--cell), inset 0 0.5px 0 var(--sep); }
  .theme:active { background: var(--cell-press); }
  .theme input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .theme > span { display: grid; gap: 0.0625rem; }
  .theme b { font-weight: 500; }
  .theme > span > span { font-size: var(--t-foot); color: var(--label-2); }
  .theme::after {
    content: ''; width: 1.125rem; height: 1.125rem; background: var(--tint); opacity: 0;
    -webkit-mask: var(--check) center / contain no-repeat;
    mask: var(--check) center / contain no-repeat;
  }
  .theme:has(input:checked)::after { opacity: 1; }
  .theme:has(input:focus-visible) { outline: 3px solid color-mix(in srgb, var(--tint) 75%, transparent); outline-offset: -3px; border-radius: var(--r-list); }
  @media (hover: hover) and (pointer: fine) { .theme:hover { background: color-mix(in srgb, var(--cell-press) 55%, var(--cell)); } }
  .score__flame { display: inline-flex; color: #ff9f0a; }
  .score__flame[hidden] { display: none; }
  .score__flame :global(.icon) { width: 1rem; height: 1rem; }
</style>
