---
import App from '../layouts/App.astro';
import { icon } from '../lib/icons';
import '../styles/play.css';

const palette = ['k', 'q', 'r', 'b', 'n', 'p'];
const names: Record<string, string> = { k: 'mbret', q: 'mbretëreshë', r: 'torrë', b: 'oficer', n: 'kalë', p: 'ushtar' };
---

<App title="Analizo · Shah" description="Analizo çdo pozicion me motorin dhe rishiko lojërat e tua nga chess.com ose Lichess me trajnerin, lëvizje pas lëvizjeje." tab="analizo" stage>
  <h1 class="visually-hidden">Analizo</h1>
  <div class="stage" data-stage-box>
    <div class="board" data-board tabindex="0" role="application" aria-label="Tabela e analizës. Luaj lëvizjet e të dy anëve.">
      <div class="promo" data-promo data-board-ui hidden role="group" aria-label="Ushtari bëhet">
        <button type="button" data-piece="q"><svg aria-hidden="true"><use href="#pc-w-q"></use></svg><span>Mbretëreshë</span></button>
        <button type="button" data-piece="r"><svg aria-hidden="true"><use href="#pc-w-r"></use></svg><span>Torrë</span></button>
        <button type="button" data-piece="b"><svg aria-hidden="true"><use href="#pc-w-b"></use></svg><span>Oficer</span></button>
        <button type="button" data-piece="n"><svg aria-hidden="true"><use href="#pc-w-n"></use></svg><span>Kalë</span></button>
        <button type="button" data-piece="x" class="promo__cancel" aria-label="Anulo"><Fragment set:html={icon('x')} /></button>
      </div>
    </div>

    <div class="bug bug--live" data-board-ui>
      <span class="bug__live">Analizë</span>
      <span class="bug__status" data-status>Motori po ngarkohet…</span>
    </div>

    <div class="bug bug--score" data-board-ui>
      <div class="score__row"><span class="score__name">Vlerësimi</span><span class="evalmini" aria-hidden="true"><i data-eval-bar></i></span><b class="tabular" data-eval>…</b></div>
      <div class="score__row"><span class="score__name">Radha</span><span class="tabular" data-turn-label>Të bardhat</span></div>
    </div>

    <ol class="strip" data-strip data-board-ui aria-label="Lëvizjet"><li class="strip__empty">Luaj një lëvizje, ose hap një lojë më poshtë.</li></ol>

    <div class="tools" data-board-ui>
      <button type="button" class="tool tool--menu" data-tools-toggle aria-expanded="false" aria-controls="tools-list" aria-label="Mjetet"><Fragment set:html={icon('dotsThreeVertical')} /></button>
      <div class="tools__list" id="tools-list">
        <button type="button" class="tool" data-reset><span class="tool__icon"><Fragment set:html={icon('plus')} /></span><span class="tool__label">Pozicioni fillestar</span></button>
        <button type="button" class="tool" data-edit aria-pressed="false"><span class="tool__icon"><Fragment set:html={icon('pencilSimple')} /></span><span class="tool__label">Rregullo pozicionin</span></button>
        <button type="button" class="tool" data-flip><span class="tool__icon"><Fragment set:html={icon('arrowsDownUp')} /></span><span class="tool__label">Rrotullo tabelën</span></button>
        <button type="button" class="tool" data-angle><span class="tool__icon"><Fragment set:html={icon('videoCamera')} /></span><span class="tool__label" data-label>Këndi i kamerës</span></button>
        <button type="button" class="tool" data-look-open><span class="tool__icon"><Fragment set:html={icon('palette')} /></span><span class="tool__label">Pamja</span></button>
        <button type="button" class="tool tool--motion" data-motion-switch aria-pressed="false"><span class="tool__icon" data-when="on"><Fragment set:html={icon('pause')} /></span><span class="tool__icon" data-when="off"><Fragment set:html={icon('play')} /></span><span class="tool__label">Ndal animacionet</span></button>
      </div>
    </div>

    <section class="lower" data-coach data-state="intro" aria-labelledby="coach-title" data-board-ui>
      <div class="lower__head">
        <h2 class="lower__tag" id="coach-title">Analiza</h2>
        <div class="lower__headline">
          <p class="lower__glyph poster" data-glyph>Analizo</p>
          <p class="lower__title" data-title></p>
        </div>
      </div>
      <div class="lower__body">
        <ul class="lower__reasons" data-reasons></ul>
        <ol class="lines" data-lines aria-label="Lëvizjet më të mira të motorit"></ol>

        <div class="editor" data-editor hidden>
          <div class="editor__pieces" role="radiogroup" aria-label="Figura">
            {(['w', 'b'] as const).map((c) =>
              palette.map((k) => (
                <button type="button" class="editor__pc" data-pen={c + k} aria-pressed="false" aria-label={`${names[k]} ${c === 'w' ? 'i bardhë' : 'i zi'}`}>
                  <svg aria-hidden="true"><use href={`#pc-${c}-${k}`}></use></svg>
                </button>
              )),
            )}
            <button type="button" class="editor__pc editor__erase" data-pen="x" aria-pressed="false" aria-label="Fshi"><Fragment set:html={icon('x')} /></button>
          </div>
          <div class="segmented segmented--2 editor__turn">
            <label><input type="radio" name="edit-turn" value="w" checked /><span>Lëvizin të bardhat</span></label>
            <label><input type="radio" name="edit-turn" value="b" /><span>Lëvizin të zezat</span></label>
          </div>
        </div>

        <div class="lower__actions" data-actions>
          <button type="button" class="cue" data-prev aria-label="Lëvizja e mëparshme"><Fragment set:html={icon('caretLeft')} /></button>
          <button type="button" class="cue" data-next aria-label="Lëvizja tjetër"><Fragment set:html={icon('caretRight')} /></button>
          <button type="button" class="cue cue--on" data-best><Fragment set:html={icon('lightbulb')} />Luaj më të mirën</button>
          <button type="button" class="cue" data-clear hidden><Fragment set:html={icon('x')} />Pastro tabelën</button>
          <button type="button" class="cue cue--on" data-done hidden><Fragment set:html={icon('check')} />Gati</button>
        </div>
      </div>
      <p class="visually-hidden" aria-live="polite" data-live></p>
    </section>
  </div>

  <section class="record" aria-labelledby="games-title">
    <h2 class="record__title" id="games-title">Rishiko lojërat e tua</h2>
    <p class="record__opening">Trajneri kalon nëpër çdo lëvizje dhe të thotë ku ndryshoi loja. Gabimet e tua bëhen ushtrime.</p>

    <form class="group fetcher" data-fetch>
      <div class="fetcher__row">
        <div class="segmented segmented--2">
          <label><input type="radio" name="site" value="chesscom" checked /><span>Chess.com</span></label>
          <label><input type="radio" name="site" value="lichess" /><span>Lichess</span></label>
        </div>
      </div>
      <label class="fetcher__row">
        <span class="visually-hidden">Emri yt i përdoruesit</span>
        <input class="field" name="user" autocomplete="username" autocapitalize="none" autocorrect="off" spellcheck="false" placeholder="Emri yt i përdoruesit" required />
      </label>
      <div class="fetcher__row"><button type="submit" class="btn btn--solid fetcher__go">Merr lojërat e fundit</button></div>
    </form>
    <p class="group-note fetcher__note" data-fetch-note role="status"></p>
    <ol class="group games-list" data-games hidden></ol>

    <h3 class="group-h">Ose ngjit një lojë</h3>
    <form class="group paste" data-paste>
      <label class="fetcher__row">
        <span class="visually-hidden">PGN ose FEN</span>
        <textarea class="field field--area" name="text" rows="4" placeholder="Ngjit këtu PGN-në e lojës (ose një FEN)" spellcheck="false"></textarea>
      </label>
      <div class="fetcher__row"><button type="submit" class="btn fetcher__go">Hap në tabelë</button></div>
    </form>
    <p class="group-note" data-paste-note role="status"></p>

    <div class="review-out" data-review hidden>
      <h3 class="group-h" data-review-title>Rishikimi</h3>
      <p class="group-note" data-review-note role="status"></p>
      <div class="segmented segmented--2 review-me">
        <label><input type="radio" name="me" value="w" checked /><span>Unë luajta me të bardhat</span></label>
        <label><input type="radio" name="me" value="b" /><span>Unë luajta me të zezat</span></label>
      </div>
      <dl class="group sheet-rows" data-review-rows></dl>
      <details class="review" open>
        <summary class="review__sum">Grafiku i lojës</summary>
        <figure class="review__fig">
          <svg class="review__svg" viewBox="0 0 1000 200" preserveAspectRatio="none" data-review-svg role="img" aria-labelledby="an-cap"></svg>
          <figcaption class="review__cap" id="an-cap" data-review-cap></figcaption>
        </figure>
        <button type="button" class="btn" data-turning hidden><Fragment set:html={icon('eye')} />Shiko momentin kyç</button>
      </details>
    </div>

    <h3 class="group-h">Lëvizjet</h3>
    <ol class="sheet" data-sheet></ol>
  </section>
  <script>
    import '../scripts/analyse';
  </script>
</App>

<style>
  .fetcher, .paste { display: grid; padding: 0.25rem 0; }
  .fetcher__row { display: block; padding: 0.5rem 1rem; }
  .fetcher__row + .fetcher__row { box-shadow: inset 1rem 0 0 var(--cell), inset 0 0.5px 0 var(--sep); }
  .fetcher__go { width: 100%; }
  .field {
    width: 100%; min-height: 44px; padding: 0.5rem 0; border: 0; background: transparent; color: var(--label);
    font-size: max(16px, var(--t-body)); outline: none;
  }
  .field::placeholder { color: var(--label-3); }
  .field--area { min-height: 6rem; resize: vertical; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 16px; }
  .fetcher__row:focus-within { box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--tint) 60%, transparent); border-radius: var(--r-list); }
  .games-list { margin-top: var(--space-xs); }
  .games-list[hidden] { display: none; }
  .review-out { margin-top: var(--space-m); }
  .review-out[hidden] { display: none; }
  .review-me { margin-block: var(--space-xs) var(--space-s); }
  .review-out :global(.sheet-rows > div) { display: flex; justify-content: space-between; align-items: center; gap: 1rem; min-height: 2.875rem; padding: 0.625rem 1rem; }
  .review-out :global(.sheet-rows > div + div) { box-shadow: inset 1rem 0 0 var(--cell), inset 0 0.5px 0 var(--sep); }
  .review-out :global(.sheet-rows > div)::before { display: none; }
  .review-out :global(.sheet-rows dd) { color: var(--label-2); font-variant-numeric: tabular-nums; text-align: end; }
  .games-list :global(.game-row) { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.125rem 0.75rem; width: 100%; text-align: start; padding: 0.75rem 1rem; }
  .games-list :global(.game-row b) { font-weight: 600; }
  .games-list :global(.game-row span) { grid-column: 1; font-size: var(--t-foot); color: var(--label-2); }
  .games-list :global(.game-row .res) { grid-column: 2; grid-row: 1 / span 2; align-self: center; font-weight: 700; font-size: var(--t-foot); padding: 0.125rem 0.625rem; border-radius: 999px; background: var(--fill-2); color: var(--label); }
  .games-list :global(.res[data-r="win"]) { color: var(--green-ink); background: color-mix(in srgb, var(--green) 18%, transparent); }
  .games-list :global(.res[data-r="loss"]) { color: var(--red-ink); background: color-mix(in srgb, var(--red) 14%, transparent); }
  .games-list :global(li + li) { box-shadow: inset 1rem 0 0 var(--cell), inset 0 0.5px 0 var(--sep); }
  .games-list :global(li + li)::before { display: none; }
</style>
