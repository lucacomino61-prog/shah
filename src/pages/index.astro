---
import App from '../layouts/App.astro';
import { icon } from '../lib/icons';
import { LESSONS } from '../data/lessons';
import '../styles/play.css';
---

<App title="Shah · Mëso shah duke luajtur" description="Trajner shahu në shqip: luaj kundër motorit, dëgjo pse ishte gabim, zgjidh ushtrime." tab={null} stage home>
  <div class="stage home" data-stage-box>
    <div class="board" data-board aria-hidden="true"></div>

    <div class="home__title" data-board-ui>
      <h1 class="home__mark poster">Shah</h1>
      <p class="home__line">Luaj kundër motorit. Pas çdo lëvizjeje, trajneri të thotë pse.</p>
      <div class="home__actions">
        <a class="cue cue--on home__go" href="/luaj/" data-go><Fragment set:html={icon('horse')} /><span data-go-label>Luaj</span></a>
        <a class="streak" href="/ushtrime/?tema=dita" data-streak hidden><Fragment set:html={icon('fire')} /><b class="tabular" data-streak-n></b><span data-streak-word>ditë</span></a>
      </div>
    </div>

    <section class="lower home__guide" aria-labelledby="guide-title" data-board-ui>
      <h2 class="visually-hidden" id="guide-title">Sot në program</h2>
      <ol class="guide">
        <li>
          <a href="/luaj/" class="guide__row">
            <span class="guide__time tabular">Tani</span>
            <span class="guide__what"><b data-game-title>Lojë me trajner</b><span data-game-line>Niveli 2, i lehtë. Ti me të bardhat.</span></span>
            <Fragment set:html={icon('caretRight')} />
          </a>
        </li>
        <li>
          <a href="/ushtrime/" class="guide__row" data-puzzle-link>
            <span class="guide__time tabular">+5 min</span>
            <span class="guide__what"><b data-puzzle-title>Ushtrime</b><span data-puzzle-line>Vlerësimi yt: 900</span></span>
            <Fragment set:html={icon('caretRight')} />
          </a>
        </li>
        <li>
          <a href={`/mesime/${LESSONS[0].slug}/`} class="guide__row" data-lesson-link>
            <span class="guide__time tabular">+10 min</span>
            <span class="guide__what"><b>Mësimi</b><span data-lesson-line>{LESSONS[0].title}</span></span>
            <Fragment set:html={icon('caretRight')} />
          </a>
        </li>
      </ol>
    </section>

    <div class="ticker" data-board-ui aria-hidden="true">
      <div class="ticker__rail"></div>
      <div class="ticker__band">
        <div class="ticker__track">
          {[0, 1].map(() => (
            <Fragment>
              <span>Trajneri flet shqip</span><span>Motori Stockfish punon në shfletuesin tënd</span><span>Ushtrime nga Lichess</span><span>Tetë mësime dhe trajneri i hapjeve</span><span>Pa llogari, pa pagesë</span>
            </Fragment>
          ))}
        </div>
      </div>
    </div>
  </div>
  <script>
    import '../scripts/home';
  </script>
</App>

<style>
  .home { --inset-top: 16rem; --inset-bottom: 14rem; }
  .home .board { pointer-events: none; }
  .home__title {
    position: absolute; z-index: 2; left: var(--gutter); right: var(--gutter); top: 1.5rem;
    display: grid; justify-items: start; gap: 0.875rem;
  }
  /* the name the way the Lock Screen sets its clock: rounded, heavy, a little translucent over the table */
  .home__mark {
    font-family: var(--font-rounded); font-size: clamp(5rem, 2rem + 17vw, 9.5rem); font-weight: 800;
    letter-spacing: -0.04em; line-height: 0.92; color: rgb(255 255 255 / 0.9);
    text-shadow: 0 2px 30px rgb(0 0 0 / 0.35);
  }
  .home__line { max-width: 28ch; color: rgb(255 255 255 / 0.82); font-weight: 500; font-size: var(--t-body); line-height: 1.32; text-shadow: 0 1px 12px rgb(0 0 0 / 0.5); }
  .home__actions { display: flex; align-items: center; gap: 0.625rem; }
  .home__go { min-height: 50px; padding-inline: 1.5rem; font-size: var(--t-body); }
  /* the streak: days in a row with today's puzzle solved, in a glass capsule with its flame */
  .streak {
    display: inline-flex; align-items: center; gap: 0.3rem; min-height: 50px; padding: 0 1.125rem; border-radius: 999px;
    color: #fff; text-decoration: none; font-weight: 600;
    background-color: var(--glass); background-image: linear-gradient(180deg, var(--glass-sheen), transparent 46%);
    -webkit-backdrop-filter: var(--blur); backdrop-filter: var(--blur);
    box-shadow: inset 0 1px 0 var(--glass-hi), inset 0 0 0 0.5px var(--glass-rim), var(--glass-depth);
  }
  .streak[hidden] { display: none; }
  .streak .icon { width: 1.25rem; height: 1.25rem; color: #ff9f0a; }
  .streak b { font-size: var(--t-title3); font-weight: 700; }
  .home__guide { padding: 0.25rem 0; gap: 0; }
  .guide { display: grid; width: 100%; }
  .guide li + li::before { content: ""; display: block; height: 0.5px; margin-inline-start: 5.25rem; background: var(--sep); }
  .guide__row {
    display: grid; grid-template-columns: 3.5rem minmax(0, 1fr) auto; align-items: center; gap: 0.75rem;
    min-height: 3.5rem; padding: 0.5rem 1rem; color: var(--label); text-decoration: none; border-radius: 1.25rem;
    transition: background-color 120ms ease;
  }
  .guide__row > .icon { width: 0.875rem; height: 0.875rem; color: var(--label-3); }
  .guide__time { font-weight: 600; font-size: var(--t-foot); color: var(--tint-ink); }
  .guide__what { display: grid; }
  .guide__what b { font-weight: 600; font-size: var(--t-body); }
  .guide__what span { font-size: var(--t-foot); color: var(--label-2); }
  .guide__row:active { background: var(--glass-press); }
  @media (hover: hover) and (pointer: fine) { .guide__row:hover { background: var(--glass-press); } }
  @media (min-width: 1024px) {
    .home { --inset-top: 7rem; --inset-bottom: 5rem; --inset-left: 22rem; --inset-right: 28rem; }
    .home__title { left: 2rem; top: 6rem; }
    .home__guide { left: auto; right: 1.5rem; width: 26rem; top: auto; bottom: calc(1rem + var(--acc-h) + 0.75rem); }
  }
</style>
