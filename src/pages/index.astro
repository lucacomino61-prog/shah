---
import App from '../layouts/App.astro';
import { icon } from '../lib/icons';
import { COURSE_ORDER, LESSONS, lessonOf } from '../data/lessons';
import { FIRST_LEVEL, levelOf } from '../lib/levels';
import { portrait } from '../lib/bots';
import '../styles/play.css';

// the first-run choices: how well the learner knows the game picks the first opponent and the first lesson
const START = [
  { id: 'new', label: 'Sapo i mësova rregullat', level: 7, lesson: 'vlera-e-figurave' },
  { id: 'some', label: 'Luaj ndonjëherë me shokët', level: 9, lesson: 'piruni' },
  { id: 'often', label: 'Luaj shpesh', level: 1, lesson: 'sulmi-i-zbuluar' },
];
---

<App title="Shah · Mëso shah duke luajtur" description="Trajner shahu në shqip: luaj kundër motorit, dëgjo pse ishte gabim, zgjidh ushtrime." tab={null} stage home>
  <div class="stage home" data-stage-box>
    <script is:inline>
      // the first visit of the day opens the board from its case: decide before the page paints, so nothing shows and
      // then hides (the Stop-animations switch and reduced motion skip it)
      try {
        var d = new Date();
        var today = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
        if (localStorage.getItem('shah.unboxed') !== today && localStorage.getItem('shah.motion') !== 'off' && !matchMedia('(prefers-reduced-motion: reduce)').matches)
          document.documentElement.dataset.hasUnbox = '';
      } catch (e) {}
    </script>
    <div class="board" data-board aria-hidden="true"></div>

    <div class="unbox" data-unbox>
      <!-- the whole table answers a tap; the capsule is the control a keyboard reaches -->
      <div class="unbox__open" data-unbox-open>
        <button type="button" class="unbox__cue"><Fragment set:html={icon('handTap')} />Prek për ta hapur</button>
      </div>
      <button type="button" class="unbox__skip" data-unbox-skip>Kalo</button>
    </div>

    <div class="home__title" data-board-ui>
      <h1 class="home__mark poster">Shah</h1>
      <p class="home__line" data-rise style="--i: 0">Luaj kundër motorit. Pas çdo lëvizjeje, trajneri të thotë pse.</p>
      <div class="home__actions" data-rise style="--i: 1">
        <a class="cue cue--on home__go" href="/luaj/" data-go><Fragment set:html={icon('horse')} /><span data-go-label>Luaj</span></a>
        <a class="streak" href="/ushtrime/?tema=dita" data-streak hidden><Fragment set:html={icon('fire')} /><b class="tabular" data-streak-n></b><span data-streak-word>ditë</span></a>
        <button type="button" class="look-open" data-look-open aria-label="Pamja: dhoma dhe figurat"><Fragment set:html={icon('palette')} /></button>
      </div>
    </div>

    <section class="lower home__dash" aria-labelledby="dash-title" data-board-ui data-rise style="--i: 2">
      <h2 class="visually-hidden" id="dash-title">Sot</h2>
      <a href="/luaj/" class="dash__opp" data-opp>
        <img class="dash__face" data-opp-face src={portrait(FIRST_LEVEL, 320)} alt="" width="320" height="400" />
        <span class="dash__who">
          <span class="dash__k" data-opp-k>Kundërshtari yt</span>
          <b class="dash__name" data-opp-name>{levelOf(FIRST_LEVEL).bot}</b>
          <span class="dash__meta" data-opp-meta>Niveli {levelOf(FIRST_LEVEL).n}</span>
        </span>
        <span class="dash__game" data-opp-board hidden></span>
        <Fragment set:html={icon('caretRight', 'icon dash__chev')} />
      </a>
      <div class="dash__tiles">
        <a href="/ushtrime/?tema=dita" class="dash__tile" data-puzzle-link>
          <span class="dash__mini" data-daily-board aria-hidden="true"></span>
          <span class="dash__tile-words">
            <span class="dash__k" data-puzzle-title>Ushtrimi i ditës</span>
            <b class="dash__v" data-puzzle-line>Një i ri çdo ditë</b>
          </span>
        </a>
        <a href={`/mesime/${COURSE_ORDER[0].slug}/`} class="dash__tile" data-lesson-link>
          <span class="dash__roman" data-lesson-chapter aria-hidden="true">I</span>
          <span class="dash__tile-words">
            <span class="dash__k">Mësimi i radhës</span>
            <b class="dash__v" data-lesson-line>{COURSE_ORDER[0].title}</b>
            <span class="dash__bar" aria-hidden="true"><span data-lesson-bar></span></span>
          </span>
        </a>
      </div>
    </section>

    <div class="ticker" data-board-ui aria-hidden="true" data-rise style="--i: 3">
      <div class="ticker__rail"></div>
      <div class="ticker__band">
        <div class="ticker__track">
          {[0, 1].map(() => (
            <Fragment>
              <span>Trajneri flet shqip</span><span>Motori Stockfish punon në shfletuesin tënd</span><span>Ushtrime nga Lichess</span><span>{LESSONS.length} mësime dhe trajneri i hapjeve</span><span>Pa llogari, pa pagesë</span>
            </Fragment>
          ))}
        </div>
      </div>
    </div>
  </div>
  <dialog class="setup welcome" data-welcome aria-labelledby="welcome-title">
    <form class="setup__form welcome__form" method="dialog" data-welcome-form novalidate>
      <p class="welcome__k">Mirë se erdhe në Shah</p>
      <h2 class="welcome__title poster" id="welcome-title" tabindex="-1">Sa e njeh shahun?</h2>
      <p class="welcome__lede">Zgjidh njërën: të gjej kundërshtarin e parë dhe mësimin nga ku të nisësh. Mund t’i ndryshosh kur të duash.</p>
      <fieldset class="welcome__choices">
        <legend class="visually-hidden">Sa e njeh shahun</legend>
        {START.map((c) => {
          const lv = levelOf(c.level);
          return (
            <label class="pick">
              <input type="radio" name="start" value={c.id} data-level={c.level} data-lesson={c.lesson} />
              <img class="pick__face" src={portrait(c.level)} alt="" width="48" height="48" />
              <span class="pick__body">
                <b>{c.label}</b>
                <span>Kundërshtari: {lv.bot}, niveli {lv.n}. Mësimi: {lessonOf(c.lesson)!.title}.</span>
              </span>
            </label>
          );
        })}
      </fieldset>
      <p class="welcome__err" data-welcome-err role="alert" hidden>Zgjidh njërën nga të trija.</p>
      <div class="setup__actions">
        <button type="submit" class="btn btn--solid" value="play"><Fragment set:html={icon('horse')} />Fillo lojën</button>
        <button type="submit" class="btn" value="lesson"><Fragment set:html={icon('bookOpenText')} />Fillo me mësimin</button>
        <button type="button" class="btn btn--quiet" data-welcome-later>Më vonë</button>
      </div>
    </form>
  </dialog>
  <script>
    import '../scripts/home';
  </script>
</App>

<style>
  .home { --inset-top: 15.5rem; --inset-bottom: 13.5rem; }

  /* the case: shut on the table until a tap opens it (sound and vibration need that touch); the rest of the page
     waits and rises in, one part after another, once the last piece is set */
  .unbox { display: none; }
  :global(html[data-has-unbox]) .unbox { position: absolute; inset: 0; z-index: 3; display: block; }
  .unbox__open {
    position: absolute; inset: 0; width: 100%; display: grid; align-items: end; justify-items: center;
    padding-bottom: calc(var(--chrome-bottom) + 2rem); cursor: pointer; -webkit-tap-highlight-color: transparent;
  }
  .unbox__cue {
    display: inline-flex; align-items: center; gap: 0.5rem; min-height: 50px; padding: 0 1.5rem; border-radius: 999px;
    color: var(--label); font-weight: 600; font-size: var(--t-body);
    background-color: var(--glass); background-image: linear-gradient(180deg, var(--glass-sheen), transparent 46%);
    -webkit-backdrop-filter: var(--blur); backdrop-filter: var(--blur);
    box-shadow: inset 0 1px 0 var(--glass-hi), inset 0 0 0 0.5px var(--glass-rim), var(--glass-depth);
    transition: transform var(--dur-press) var(--ease-out);
    animation: cue-breathe 2.4s ease-in-out infinite;
  }
  .unbox__cue :global(.icon) { width: 1.25rem; height: 1.25rem; }
  .unbox__open:active .unbox__cue { transform: scale(0.96); }
  .unbox__cue:focus-visible { outline: 3px solid color-mix(in srgb, var(--tint) 75%, transparent); outline-offset: 3px; }
  @keyframes cue-breathe { 50% { box-shadow: inset 0 1px 0 var(--glass-hi), inset 0 0 0 0.5px var(--glass-rim), var(--glass-depth), 0 0 0 6px rgb(255 255 255 / 0.08); } }
  .unbox__skip {
    position: absolute; top: max(env(safe-area-inset-top), 0.75rem); right: 0.75rem; min-height: 44px; padding: 0 1rem; border-radius: 999px;
    color: var(--hero-ink-2); font-weight: 600; font-size: var(--t-sub);
  }
  .unbox__skip:focus-visible { outline: 3px solid color-mix(in srgb, var(--tint) 75%, transparent); outline-offset: 2px; }
  /* on a wide screen the navigation bar holds the top: Kalo sits under it */
  @media (min-width: 1024px) { .unbox__skip { top: 5.25rem; right: 1.5rem; } }
  /* opened: the cue goes, the case does the rest */
  .unbox[data-opening] .unbox__open { pointer-events: none; }
  .unbox[data-opening] .unbox__cue { opacity: 0; transform: scale(0.94); filter: blur(6px); transition: opacity 260ms var(--ease-out), transform 260ms var(--ease-out), filter 260ms var(--ease-out); animation: none; }
  :global(html[data-has-unbox]) .home .board { opacity: 0; }
  .home .board { transition: opacity 360ms var(--ease-out); }
  :global(html[data-has-unbox]) [data-rise] { opacity: 0; transform: translateY(14px); pointer-events: none; }
  [data-rise] { transition: opacity 460ms var(--ease-out), transform 460ms var(--ease-out); transition-delay: calc(var(--i, 0) * 80ms); }
  :global(html[data-motion="off"]) [data-rise] { transition: none; }
  .home .board { pointer-events: none; }
  .home__title {
    position: absolute; z-index: 2; left: var(--gutter); right: var(--gutter); top: 1.5rem;
    display: grid; justify-items: start; gap: 0.875rem;
  }
  /* the name at poster size in the Didone, light over the dark room */
  .home__mark {
    font-size: clamp(5.5rem, 2rem + 18vw, 10.5rem); font-weight: 600;
    letter-spacing: -0.035em; line-height: 0.9; color: var(--hero-ink);
    text-shadow: 0 2px 30px var(--hero-shade);
  }
  .home__line { max-width: 28ch; color: var(--hero-ink-2); font-weight: 500; font-size: var(--t-body); line-height: 1.32; text-shadow: 0 1px 12px var(--hero-shade); }
  .home__actions { display: flex; align-items: center; gap: 0.625rem; }
  .home__go { min-height: 50px; padding-inline: 1.5rem; font-size: var(--t-body); }
  /* the streak: days in a row with today's puzzle solved, in a glass capsule with its flame */
  .streak {
    display: inline-flex; align-items: center; gap: 0.3rem; min-height: 50px; padding: 0 1.125rem; border-radius: 999px;
    color: var(--label); text-decoration: none; font-weight: 600;
    background-color: var(--glass); background-image: linear-gradient(180deg, var(--glass-sheen), transparent 46%);
    -webkit-backdrop-filter: var(--blur); backdrop-filter: var(--blur);
    box-shadow: inset 0 1px 0 var(--glass-hi), inset 0 0 0 0.5px var(--glass-rim), var(--glass-depth);
  }
  .streak[hidden] { display: none; }
  /* a narrow phone keeps the flame and the number; the words stay for screen readers in its name */
  @media (max-width: 420px) { .streak [data-streak-word] { display: none; } }
  /* Pamja: the room and the pieces, a glass circle beside the capsules */
  .look-open {
    display: inline-grid; place-items: center; width: 50px; height: 50px; border-radius: 999px; color: var(--label);
    background-color: var(--glass); background-image: linear-gradient(180deg, var(--glass-sheen), transparent 46%);
    -webkit-backdrop-filter: var(--blur); backdrop-filter: var(--blur);
    box-shadow: inset 0 1px 0 var(--glass-hi), inset 0 0 0 0.5px var(--glass-rim), var(--glass-depth);
    transition: transform var(--dur-press) var(--ease-out);
  }
  .look-open:active { transform: scale(0.94); }
  .look-open .icon { width: 1.375rem; height: 1.375rem; }
  .look-open:focus-visible { outline: 3px solid color-mix(in srgb, var(--tint) 75%, transparent); outline-offset: 3px; }
  .streak .icon { width: 1.25rem; height: 1.25rem; color: #ff9f0a; }
  .streak b { font-size: var(--t-title3); font-weight: 700; }
  /* the dashboard: who sits across next (or the game that waits), today's puzzle as a diagram, the next lesson */
  .home__dash { padding: 0.375rem; gap: 0.25rem; }
  .dash__opp {
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto; align-items: center; gap: 0.875rem;
    padding: 0.5rem 0.75rem 0.5rem 0.5rem; border-radius: 1.25rem; color: var(--label); text-decoration: none;
    transition: background-color 120ms ease, transform var(--dur-press) var(--ease-out);
  }
  .dash__face { width: 3.5rem; height: 4.375rem; border-radius: 0.875rem; object-fit: cover; box-shadow: 0 0 0 0.5px rgb(255 255 255 / 0.2), 0 6px 14px -6px rgb(0 0 0 / 0.6); }
  .dash__who { display: grid; gap: 0.0625rem; min-width: 0; }
  .dash__k { font-size: var(--t-cap); font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--label-2); }
  .dash__name { font-family: var(--font-display); font-size: 1.625rem; font-weight: 600; line-height: 1.05; letter-spacing: -0.01em; }
  .dash__meta { font-size: var(--t-foot); color: var(--label-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dash__game { width: 3.25rem; }
  .dash__game[hidden] { display: none; }
  :global(.dash__chev) { width: 0.875rem; height: 0.875rem; color: var(--label-3); }
  .dash__tiles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.25rem; }
  .dash__tile {
    display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 0.625rem; min-height: 3.75rem;
    padding: 0.5rem 0.625rem; border-radius: 1.125rem; background: var(--fill-2); color: var(--label); text-decoration: none;
    transition: background-color 120ms ease, transform var(--dur-press) var(--ease-out);
  }
  .dash__mini { width: 2.75rem; }
  .dash__mini:empty { height: 2.75rem; border-radius: 0.3125rem; background: var(--fill); }
  .dash__roman { display: grid; place-items: center; width: 2.75rem; font-family: var(--font-display); font-size: 1.875rem; font-weight: 500; line-height: 1; color: #e2c48c; }
  :global(html[data-world-tone='light']) .dash__roman { color: #8a5a22; }
  .dash__tile-words { display: grid; gap: 0.125rem; min-width: 0; }
  .dash__tile .dash__k { font-size: var(--t-cap2); }
  .dash__v { font-size: var(--t-foot); font-weight: 600; line-height: 1.2; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .dash__bar { display: block; height: 0.1875rem; margin-top: 0.25rem; border-radius: 999px; background: var(--fill); overflow: hidden; }
  .dash__bar span { display: block; height: 100%; background: linear-gradient(90deg, #c99a52, #ecd29c); transform: scaleX(0); transform-origin: left; transition: transform 700ms var(--ease-out) 250ms; }
  .dash__opp:active, .dash__tile:active { transform: scale(0.98); }
  @media (hover: hover) and (pointer: fine) { .dash__opp:hover { background: var(--glass-press); } .dash__tile:hover { background: var(--fill); } }

  /* the first visit: one question, three answers, each with the opponent it brings */
  .welcome__form { gap: 1rem; padding-top: 1.125rem; }
  .welcome__k { text-align: center; font-size: var(--t-cap); font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--label-2); }
  .welcome__title { margin-top: -0.5rem; text-align: center; font-size: 2.375rem; line-height: 1; letter-spacing: -0.02em; }
  .welcome__title:focus { outline: none; }
  .welcome__lede { text-align: center; font-size: var(--t-sub); color: var(--label-2); max-width: 34ch; margin-inline: auto; }
  .welcome__choices { display: grid; gap: 0.5rem; border: 0; padding: 0; margin: 0; }
  .pick {
    position: relative; display: grid; grid-template-columns: 3rem minmax(0, 1fr); align-items: center; gap: 0.875rem;
    padding: 0.625rem 0.875rem 0.625rem 0.625rem; border-radius: 1.25rem; background: var(--fill-2); cursor: pointer;
    transition: box-shadow var(--dur-ui) var(--ease-out), transform var(--dur-press) var(--ease-out);
  }
  .pick:active { transform: scale(0.985); }
  .pick input { position: absolute; inset: 0; margin: 0; opacity: 0; cursor: pointer; }
  .pick__face { width: 3rem; height: 3rem; border-radius: 50%; object-fit: cover; }
  .pick__body { display: grid; gap: 0.125rem; }
  .pick__body b { font-family: var(--font-display); font-size: var(--t-title3); font-weight: 600; line-height: 1.15; }
  .pick__body span { font-size: var(--t-foot); line-height: 1.3; color: var(--label-2); }
  .pick:has(input:checked) { box-shadow: inset 0 0 0 2px var(--tint); }
  .pick:has(input:focus-visible) { outline: 3px solid color-mix(in srgb, var(--tint) 75%, transparent); outline-offset: 2px; }
  .welcome__err { text-align: center; font-size: var(--t-foot); font-weight: 600; color: var(--red-ink); }
  .welcome__err[hidden] { display: none; }

  @media (min-width: 1024px) {
    .home { --inset-top: 7rem; --inset-bottom: 5rem; --inset-left: 22rem; --inset-right: 28rem; }
    .home__title { left: 2rem; top: 6rem; }
    .home__dash { left: auto; right: 1.5rem; width: 27rem; top: auto; bottom: calc(1rem + var(--acc-h) + 0.75rem); }
  }
</style>
