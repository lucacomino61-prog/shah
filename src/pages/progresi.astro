---
import App from '../layouts/App.astro';
import { icon } from '../lib/icons';
---

<App title="Progresi · Shah" description="Lojërat, ushtrimet dhe gabimet e tua më të shpeshta, të ruajtura vetëm në këtë pajisje." tab="progresi">
  <div class="page progress">
    <h1 class="page-title poster">Progresi</h1>
    <p class="lede">Gjithçka ruhet vetëm në këtë shfletues. Askush tjetër nuk e sheh.</p>

    <section aria-labelledby="sum-title">
      <h2 class="group-h" id="sum-title">Përmbledhja</h2>
      <dl class="group sheet-rows" data-summary>
        {['Lojëra', 'Saktësia mesatare', 'Vlerësimi në ushtrime', 'Ushtrime të zgjidhura pa ndihmë', 'Mësime të kryera'].map((k) => <div><dt>{k}</dt><dd>&nbsp;</dd></div>)}
      </dl>
    </section>

    <section aria-labelledby="err-title">
      <h2 class="group-h" id="err-title">Gabimet që përsërit</h2>
      <p class="group-note">Trajneri i numëron sipas llojit. Lidhja poshtë secilit të çon te mësimi që e trajton.</p>
      <ol class="group mistakes" data-mistakes><li class="empty">&nbsp;</li></ol>
    </section>

    <section aria-labelledby="games-title">
      <h2 class="group-h" id="games-title">Lojërat e fundit</h2>
      <ol class="group games" data-games><li class="empty">&nbsp;</li></ol>
    </section>

    <section aria-labelledby="look-title">
      <h2 class="group-h" id="look-title">Cilësimet</h2>
      <div class="group settings">
        <label class="row"><span>Tingujt dhe dridhja</span><input type="checkbox" class="switch" data-sound /></label>
        <label class="row"><span>Trego rreziqet në lojë</span><input type="checkbox" class="switch" data-threats-pref /></label>
        <div class="look">
        <label class="look__label" for="glass-level">Xhami</label>
        <div class="look__range">
          <span aria-hidden="true">I qartë</span>
          <input id="glass-level" type="range" min="0" max="1" step="0.05" value="0.5" data-glass aria-valuetext="Mesatar" />
          <span aria-hidden="true">I ngjyrosur</span>
        </div>
        </div>
      </div>
      <p class="group-note look__note">Rreziqet: një rreth i kuq rreth figurave të tua që kundërshtari mund t’i marrë në lëvizjen tjetër. Xhami: sa shihet tabela përmes menyve dhe kartave; majtas më e qartë, djathtas më e lexueshme.</p>
    </section>

    <section aria-labelledby="backup-title">
      <h2 class="group-h" id="backup-title">Kopja rezervë</h2>
      <div class="group backup">
        <button type="button" class="row" data-export><span>Ruaj një kopje</span><Fragment set:html={icon('downloadSimple')} /></button>
        <button type="button" class="row" data-import><span>Ngarko një kopje</span><Fragment set:html={icon('uploadSimple')} /></button>
      </div>
      <input type="file" accept="application/json,.json" hidden data-import-file />
      <p class="group-note look__note" data-backup-note role="status">Progresi ruhet vetëm në këtë shfletues. Ruaj një kopje për ta çuar në një telefon tjetër, ose për ta pasur të sigurt.</p>
    </section>

    <section aria-labelledby="about-title">
      <h2 class="group-h" id="about-title">Rreth aplikacionit</h2>
      <p class="group about">
        Shah është softuer i lirë me licencën GPL-3.0. Motori është <a href="https://stockfishchess.org/">Stockfish</a>, që punon
        brenda shfletuesit tënd. Ushtrimet vijnë nga baza e hapur e <a href="https://database.lichess.org/#puzzles">Lichess</a>.
        Kodi burimor: <a href="https://github.com/lucacomino61-prog/shah">github.com/lucacomino61-prog/shah</a>.
      </p>
    </section>

    <div class="group progress__reset">
      <button type="button" class="row reset" data-reset><span data-label>Fshi progresin</span><Fragment set:html={icon('x')} /></button>
    </div>
  </div>
  <script>
    import '../scripts/progress';
  </script>
</App>

<style>
  .progress { max-width: 46rem; margin-inline: auto; }
  .about { padding: 0.875rem 1rem; color: var(--label-2); font-size: var(--t-sub); line-height: 1.45; }
  .about a { color: var(--tint-ink); text-decoration: none; }
  .about a:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .progress__reset { margin-top: var(--space-l); }
  .reset { width: 100%; text-align: start; color: var(--red-ink); font-size: var(--t-body); }
  .reset .icon { width: 1rem; height: 1rem; }
  .progress :global(.sheet-rows > div) { display: flex; justify-content: space-between; align-items: center; gap: 1rem; min-height: 2.875rem; padding: 0.625rem 1rem; }
  .progress :global(.sheet-rows > div + div) { box-shadow: inset 1rem 0 0 var(--cell), inset 0 0.5px 0 var(--sep); }
  .progress :global(.sheet-rows > div)::before { display: none; }
  .progress :global(.sheet-rows dd) { color: var(--label-2); font-variant-numeric: tabular-nums; text-align: end; }
  .progress :global(.mistakes li:not(.empty)), .progress :global(.games li:not(.empty)) {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.125rem 1rem; align-items: center;
    padding: 0.75rem 1rem;
  }
  .progress :global(.mistakes > li + li::before), .progress :global(.games > li + li::before) { display: none; }
  .progress :global(.mistakes > li + li), .progress :global(.games > li + li) { box-shadow: inset 1rem 0 0 var(--cell), inset 0 0.5px 0 var(--sep); }
  .progress :global(.mistakes b) { font-weight: 600; }
  .progress :global(.mistakes .n) { font-weight: 700; font-size: var(--t-title3); font-variant-numeric: tabular-nums; color: var(--label-2); }
  .progress :global(.mistakes li:not(.empty) a) { grid-column: 1 / -1; justify-self: start; display: inline-flex; align-items: center; min-height: 44px; color: var(--tint-ink); font-weight: 500; font-size: var(--t-sub); text-decoration: none; }
  .progress :global(.games .res) { font-weight: 700; font-size: var(--t-foot); padding: 0.125rem 0.625rem; border-radius: 999px; background: var(--fill-2); }
  .progress :global(.games .res[data-r="win"]) { color: var(--green-ink); background: color-mix(in srgb, var(--green) 18%, transparent); }
  .progress :global(.games .res[data-r="loss"]) { color: var(--red-ink); background: color-mix(in srgb, var(--red) 14%, transparent); }
  .progress :global(.games .meta) { grid-column: 1 / -1; }
  .progress :global(.empty a) { display: flex; align-items: center; min-height: 44px; margin-top: 0.25rem; color: var(--tint-ink); font-weight: 600; text-decoration: none; }
  .backup > * + * { box-shadow: inset 1rem 0 0 var(--cell), inset 0 0.5px 0 var(--sep); }
  .backup .row { width: 100%; text-align: start; color: var(--tint-ink); }
  .backup .icon { width: 1.125rem; height: 1.125rem; }
  .settings > * + * { box-shadow: inset 1rem 0 0 var(--cell), inset 0 0.5px 0 var(--sep); }
  .look { display: grid; gap: 0.5rem; padding: 0.875rem 1rem 1rem; }
  .look__label { font-size: var(--t-body); }
  .look__range { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 0.75rem; font-size: var(--t-foot); color: var(--label-2); }
  .look__note { margin-top: var(--space-2xs); }
  /* the iOS slider: a thin track filled in the tint up to a white thumb */
  .look input { -webkit-appearance: none; appearance: none; width: 100%; height: 2.75rem; margin: 0; background: transparent; cursor: pointer; --pct: 50%; }
  .look input::-webkit-slider-runnable-track { height: 4px; border-radius: 999px; background: linear-gradient(90deg, var(--tint) var(--pct), var(--fill) 0); }
  .look input::-moz-range-track { height: 4px; border-radius: 999px; background: var(--fill); }
  .look input::-moz-range-progress { height: 4px; border-radius: 999px; background: var(--tint); }
  .look input::-webkit-slider-thumb { -webkit-appearance: none; width: 1.75rem; height: 1.75rem; margin-top: -0.75rem; border-radius: 50%; background: #fff; box-shadow: 0 0.5px 4px rgb(0 0 0 / 0.12), 0 6px 13px rgb(0 0 0 / 0.12), 0 0 0 0.5px rgb(0 0 0 / 0.04); }
  .look input::-moz-range-thumb { width: 1.75rem; height: 1.75rem; border: 0; border-radius: 50%; background: #fff; box-shadow: 0 0.5px 4px rgb(0 0 0 / 0.12), 0 6px 13px rgb(0 0 0 / 0.12); }
</style>
