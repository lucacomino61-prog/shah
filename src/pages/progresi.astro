---
import App from '../layouts/App.astro';
import { icon } from '../lib/icons';
import { LEVELS } from '../lib/levels';
import { portrait } from '../lib/bots';
import { badges } from '../lib/record';
import { fresh } from '../lib/store';

// the medals as a newcomer sees them; the page script marks the ones earned
const BADGES = badges(fresh());
const TABS = [
  ['Pasqyra', 'chartLineUp'],
  ['Lojtarët', 'users'],
  ['Medaljet', 'trophy'],
  ['Lojërat', 'listNumbers'],
] as const;
---

<App title="Progresi · Shah" description="Lojërat, ushtrimet dhe gabimet e tua më të shpeshta, të ruajtura vetëm në këtë pajisje." tab="progresi" room>
  <script is:inline>
    // a sync link from before the settings had their own page
    if (/^#sync=/.test(location.hash)) location.replace('/progresi/cilesimet/' + location.hash);
  </script>
  <div class="screen screen--split progress">
    <header class="screen__head">
      <div>
        <h1 class="screen__title poster">Progresi</h1>
        <p class="screen__sub">Ruhet vetëm në këtë shfletues. <a class="screen__link" href="/progresi/cilesimet/#backup-title">Ruaj një kopje</a></p>
      </div>
      <a class="gear" href="/progresi/cilesimet/" aria-label="Cilësimet"><Fragment set:html={icon('gear')} /></a>
    </header>

    <div class="pager-tabs" role="tablist" aria-label="Progresi" data-pager-tabs="progress">
      {TABS.map(([t, ic], i) => <button type="button" role="tab" data-pager-tab={i} aria-controls={`pg-${i}`}><Fragment set:html={icon(ic, 'icon tab__icon')} />{t}</button>)}
    </div>

    <div class="pager" data-pager="progress">
      <!-- the overview: the three figures, the short facts, accuracy game by game -->
      <section class="pager__page" role="tabpanel" id="pg-0" aria-label="Pasqyra">
        <div class="page-col stagger">
          <dl class="stats glass-card" style="--i: 0">
            <div class="stat"><dt>Lojëra</dt><dd><b class="stat__n tabular" data-fig="games">0</b><span class="stat__bar" data-fig-bar aria-hidden="true" hidden><span data-part="win"></span><span data-part="draw"></span><span data-part="loss"></span></span><span class="stat__sub" data-fig-sub="games">&nbsp;</span></dd></div>
            <div class="stat"><dt>Saktësia</dt><dd><b class="stat__n tabular" data-fig="acc">–</b><span class="stat__sub" data-fig-sub="acc">&nbsp;</span></dd></div>
            <div class="stat"><dt>Ushtrimet</dt><dd><b class="stat__n tabular" data-fig="rating">900</b><span class="stat__sub" data-fig-sub="rating">&nbsp;</span></dd></div>
          </dl>
          <dl class="facts glass-card" data-summary style="--i: 1">
            {['Mësime', 'Seria', 'Gara'].map((k) => <div><dt>{k}</dt><dd>&nbsp;</dd></div>)}
          </dl>
          <figure class="chart glass-card" style="--i: 2">
            <figcaption class="chart__head"><b>Saktësia, lojë pas loje</b><span class="chart__cap" id="acc-cap" data-acc-cap>Grafiku shfaqet pas lojës së parë.</span></figcaption>
            <svg class="chart__svg" data-acc-chart role="img" aria-labelledby="acc-cap"></svg>
            <div class="chart__empty" data-acc-empty hidden>
              <p>Pas çdo loje, saktësia jote shtohet këtu.</p>
              <a class="btn btn--solid" href="/luaj/">Luaj lojën e parë</a>
            </div>
            <ul class="chart__key" aria-hidden="true"><li data-r="win">Fitore</li><li data-r="draw">Barazim</li><li data-r="loss">Humbje</li></ul>
          </figure>
        </div>
      </section>

      <!-- the club: the record against each opponent, easiest first -->
      <section class="pager__page" role="tabpanel" id="pg-1" aria-label="Lojtarët">
        <ol class="ladder glass-card stagger">
          {LEVELS.map((l, i) => (
            <li class="rung" data-rung={l.id} style={`--i: ${i}`}>
              <button type="button" class="rung__go" data-pick={l.id}>
                <img class="rung__face" src={portrait(l.id)} alt="" width="40" height="40" decoding="async" />
                <span class="rung__who"><b class="rung__name">{l.bot}</b><span class="rung__lv" data-lv>Niveli {l.n}</span></span>
                <span class="rung__bar" aria-hidden="true"><span data-part="win"></span><span data-part="draw"></span><span data-part="loss"></span></span>
                <span class="rung__score tabular" data-score>–</span>
              </button>
            </li>
          ))}
        </ol>
      </section>

      <!-- the medals -->
      <section class="pager__page" role="tabpanel" id="pg-2" aria-label="Medaljet">
        <div class="medals-box glass-card">
          <div class="medals-head">
            <p class="medals-note" data-medals-note>Fitohen me lojëra, ushtrime dhe mësime.</p>
            <button type="button" class="medals-share" data-share-medals hidden><Fragment set:html={icon('shareNetwork')} /><span>Ndaje</span></button>
          </div>
          <ul class="medals stagger">
            {BADGES.map((b, i) => (
              <li class="badge" data-badge={b.id} style={`--i: ${i}`}>
                <span class="medal" aria-hidden="true"><Fragment set:html={icon(b.icon)} /></span>
                <b class="badge__title">{b.title}</b>
                <span class="badge__state" data-badge-state>{b.progress ? `${b.progress[0]} nga ${b.progress[1]}` : 'Ende jo'}</span>
                <span class="visually-hidden">{b.how}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- the games: the mistakes that keep coming back in them, then the last games, as many as the page holds -->
      <section class="pager__page" role="tabpanel" id="pg-3" aria-label="Lojërat">
        <div class="page-col stagger">
          <div class="cure glass-card" style="--i: 0" data-cure hidden>
            <h2 class="cure__h">Gabimet që përsërit</h2>
            <ol class="mistakes" data-mistakes></ol>
          </div>
          <div class="games-box glass-card" style="--i: 1">
            <ol class="games" data-games><li class="empty">&nbsp;</li></ol>
          </div>
        </div>
      </section>
    </div>
  </div>
  <script>
    import '../scripts/progress';
  </script>
</App>

<style>
  .gear {
    flex: none; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; color: var(--label);
    background: var(--room-glass); box-shadow: inset 0 1px 0 var(--glass-hi), inset 0 0 0 0.5px var(--glass-rim), var(--glass-depth);
    transition: transform var(--dur-press) var(--ease-out);
  }
  .gear :global(.icon) { width: 1.375rem; height: 1.375rem; transition: rotate 560ms cubic-bezier(0.34, 1.56, 0.64, 1); }
  .gear:active { transform: scale(0.94); }
  .gear:active :global(.icon) { rotate: 60deg; }
  .glass-card { border-radius: 1.375rem; }

  /* the overview: a column that fills the page, the chart taking what the rest leave */
  .page-col { display: flex; flex-direction: column; gap: 0.5rem; height: 100%; }
  .page-col > * { flex: none; }
  .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); padding: 0.75rem 0.25rem; }
  .stat { display: grid; align-content: start; gap: 0.125rem; padding-inline: clamp(0.5rem, 2.4vw, 0.75rem); min-width: 0; }
  .stat + .stat { box-shadow: inset 0.5px 0 0 var(--sep); }
  .stat dt { font-size: var(--t-cap2); font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--label-2); }
  .stat dd { display: grid; gap: 0.125rem; }
  .stat__n { font-family: var(--font-display); font-size: clamp(1.75rem, 0.6rem + 4dvh, 2.75rem); font-weight: 600; line-height: 1; letter-spacing: -0.02em; }
  .stat__sub { font-size: var(--t-cap2); line-height: 1.25; color: var(--label-2); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  /* the games won, drawn and lost, as the ladder draws them */
  .stat__bar { display: flex; height: 0.25rem; margin-block: 0.25rem 0.125rem; border-radius: 999px; overflow: hidden; background: var(--fill-2); }
  .stat__bar[hidden] { display: none; }
  .stat__bar span { flex: 0 0 auto; width: 0; }
  .stat__bar [data-part='win'] { background: var(--win); }
  .stat__bar [data-part='draw'] { background: var(--draw); }
  .stat__bar [data-part='loss'] { background: var(--loss); }
  .facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); padding: 0.5rem 0.25rem; }
  .facts > div { display: grid; gap: 0.0625rem; padding-inline: 0.75rem; min-width: 0; }
  .facts > div + div { box-shadow: inset 0.5px 0 0 var(--sep); }
  .facts dt { font-size: var(--t-cap2); font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--label-2); }
  .facts dd { font-size: var(--t-foot); font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .chart { flex: 1 1 auto !important; min-height: 6.5rem; display: flex; flex-direction: column; margin: 0; padding: 0.625rem 0.75rem 0.5rem; }
  .chart__head { display: grid; gap: 0.0625rem; padding-inline: 0.25rem; }
  .chart__head b { font-family: var(--font-display); font-size: var(--t-title3); font-weight: 600; }
  .chart__cap { font-size: var(--t-cap); color: var(--label-2); }
  .chart__svg { flex: 1 1 auto; min-height: 0; width: 100%; margin-top: 0.375rem; overflow: visible; }
  /* a newcomer: no empty frame, but what will appear here and the way to make it appear */
  .chart__empty { flex: 1 1 auto; display: grid; align-content: center; justify-items: start; gap: 0.75rem; padding: 0.5rem 0.25rem; }
  .chart__empty[hidden] { display: none; }
  .chart__empty p { max-width: 34ch; font-size: var(--t-sub); line-height: 1.35; color: var(--label-2); }
  .chart__empty .btn { min-height: 44px; }
  .chart:has(.chart__empty:not([hidden])) .chart__key { display: none; }
  .screen__link { color: var(--tint-ink); font-weight: 600; text-decoration: none; white-space: nowrap; }
  .chart__key { display: flex; gap: 0.25rem 0.875rem; margin-top: 0.25rem; padding-inline: 0.25rem; font-size: var(--t-cap2); color: var(--label-2); }
  .chart__key li { display: inline-flex; align-items: center; gap: 0.3rem; }
  .chart__key li::before { content: ''; width: 0.45rem; height: 0.45rem; border-radius: 50%; background: var(--r); }
  :global(:root) { --win: #d9b26f; --draw: #b9b2a6; --loss: #e0675c; }
  :global(html[data-world-tone='light']) { --win: #a87a2e; --draw: #8e8a83; --loss: #c2372b; }
  .chart__key [data-r='win'] { --r: var(--win); }
  .chart__key [data-r='draw'] { --r: var(--draw); }
  .chart__key [data-r='loss'] { --r: var(--loss); }
  .chart__svg :global(.grid) { stroke: var(--sep); stroke-width: 1; }
  .chart__svg :global(.tick) { fill: var(--label-2); font: 600 11px var(--font); }
  .chart__svg :global(.avg) { stroke: var(--label-2); stroke-width: 1.25; stroke-dasharray: 4 5; }
  .chart__svg :global(.trace) { fill: none; stroke: color-mix(in srgb, var(--label) 55%, transparent); stroke-width: 1.75; stroke-linejoin: round; }
  .chart__svg :global(.dot) { stroke: var(--room-glass, #000); stroke-width: 2; }
  .chart__svg :global(.dot[data-r='win']) { fill: var(--win); }
  .chart__svg :global(.dot[data-r='draw']) { fill: var(--draw); }
  .chart__svg :global(.dot[data-r='loss']), .chart__svg :global(.dot[data-r='resigned']) { fill: var(--loss); }

  .cure { padding: 0.625rem 0.75rem 0.375rem; }
  .cure[hidden] { display: none; }
  .cure__h { padding-inline: 0.25rem; font-family: var(--font-display); font-size: var(--t-title3); font-weight: 600; }
  .mistakes :global(li:not(.empty)) { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 0 0.75rem; padding: 0.375rem 0.25rem; }
  .mistakes :global(li + li) { box-shadow: inset 0 0.5px 0 var(--sep); }
  .mistakes :global(b) { font-weight: 600; font-size: var(--t-sub); }
  .mistakes :global(.n) { font-weight: 700; font-variant-numeric: tabular-nums; color: var(--label-2); }
  .mistakes :global(a) { grid-column: 1 / -1; display: inline-flex; align-items: center; min-height: 32px; color: var(--tint-ink); font-weight: 500; font-size: var(--t-foot); text-decoration: none; }
  .mistakes :global(.empty) { padding: 0.375rem 0.25rem 0.5rem; color: var(--label-2); font-size: var(--t-foot); }
  .mistakes :global(.empty a) { display: inline; color: var(--tint-ink); font-weight: 600; text-decoration: none; }
  /* a short phone: the overview keeps its figures, the chart and the mistake that comes back most */
  @media (max-height: 720px) { .mistakes :global(li:nth-child(n + 2)) { display: none; } .chart__key { display: none; } }
  @media (max-height: 640px) {
    .facts { display: none; }
    .chart__empty { gap: 0.5rem; padding-block: 0.25rem; }
    .chart__cap { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .chart { min-height: 5rem; }
    .mistakes :global(li:not(.empty) a) { min-height: 28px; }
    .rung__lv { display: none; }
    .rung__name { font-size: var(--t-callout); }
  }

  /* the club ladder: one row each, the bar between the name and the score */
  .ladder { display: flex; flex-direction: column; justify-content: space-between; height: 100%; padding: 0.375rem 0.25rem; }
  /* each opponent is a button: a tap seats them for the next game */
  .rung { flex: 1 1 0; min-height: 0; display: flex; }
  .rung__go {
    flex: 1 1 auto; min-width: 0; display: grid; grid-template-columns: auto minmax(0, 6.5rem) minmax(0, 1fr) auto; align-items: center; gap: 0.75rem;
    padding: 0 0.75rem; border-radius: 0.875rem; color: inherit; text-align: start; font: inherit;
    transition: background-color var(--dur-ui) ease, transform var(--dur-press) var(--ease-out);
  }
  .rung__go:active { transform: scale(0.985); background: var(--glass-press); }
  .rung__go:focus-visible { outline: 3px solid color-mix(in srgb, var(--tint) 75%, transparent); outline-offset: -3px; }
  @media (hover: hover) and (pointer: fine) { .rung__go:hover { background: var(--glass-press); } }
  /* the learner's level in brass, the next opponent in the tint, as the course marks the next lesson */
  .rung[data-mine] .rung__face { box-shadow: 0 0 0 2px #d9b26f, 0 0 0 4px rgb(217 178 111 / 0.25); }
  .rung[data-mine] .rung__lv { color: var(--win); font-weight: 700; }
  .rung[data-next] .rung__go { background: color-mix(in srgb, var(--tint) 14%, transparent); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--tint) 40%, transparent); }
  .rung[data-next] .rung__lv { color: var(--tint-ink); font-weight: 700; }
  .rung + .rung { box-shadow: inset 0 0.5px 0 var(--sep); }
  .rung__face { width: clamp(1.75rem, 0.6rem + 3.6dvh, 2.5rem); height: auto; aspect-ratio: 1; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 1.5px rgb(255 255 255 / 0.18); }
  .rung__who { display: grid; min-width: 0; }
  /* the Didone's glyphs stand 1.4em tall: the clip gets that room, the layout keeps its line */
  .rung__name { font-family: var(--font-display); font-size: var(--t-title3); font-weight: 600; line-height: 1.2; padding-block: 0.1em; margin-block: -0.1em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rung__lv { font-size: var(--t-cap2); color: var(--label-2); }
  .rung__bar { display: flex; height: 0.375rem; border-radius: 999px; overflow: hidden; background: var(--fill-2); }
  .rung__bar span { flex: 0 0 auto; width: 0; }
  .rung__bar [data-part='win'] { background: var(--win); }
  .rung__bar [data-part='draw'] { background: var(--draw); }
  .rung__bar [data-part='loss'] { background: var(--loss); }
  .rung__score { min-width: 4.25rem; text-align: end; font-size: var(--t-foot); font-weight: 600; }
  .rung[data-none] .rung__face { filter: grayscale(0.7) brightness(0.75); }
  .rung[data-none] .rung__score { font-weight: 500; color: var(--label-3); }

  /* the medals: four across, struck brass when earned, an engraved ring while still to win */
  .medals-box { display: flex; flex-direction: column; height: 100%; padding: 0.75rem 0.5rem; }
  .medals-head { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding: 0 0.25rem 0.375rem 0.5rem; }
  .medals-note { font-size: var(--t-foot); color: var(--label-2); }
  .medals-share { flex: none; display: inline-flex; align-items: center; gap: 0.375rem; min-height: 44px; padding: 0 0.875rem; border-radius: 999px; background: var(--fill-2); color: var(--label); font-weight: 600; font-size: var(--t-foot); }
  .medals-share[hidden] { display: none; }
  .medals-share :global(.icon) { width: 1rem; height: 1rem; }
  .medals-share:active { transform: scale(0.96); }
  .medals { flex: 1 1 auto; min-height: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-template-rows: repeat(3, minmax(0, 1fr)); gap: 0.25rem 0.25rem; }
  .badge { display: grid; justify-items: center; align-content: center; gap: 0.1875rem; min-width: 0; text-align: center; }
  .medal { display: grid; place-items: center; width: clamp(2.5rem, 0.8rem + 5dvh, 3.75rem); aspect-ratio: 1; border-radius: 50%; color: rgb(226 196 140 / 0.42); box-shadow: inset 0 0 0 1.5px rgb(226 196 140 / 0.32), inset 0 0 0 5px rgb(0 0 0 / 0.08); }
  .medal :global(.icon) { width: 45%; height: 45%; }
  .badge[data-earned] .medal {
    color: #5b3a12;
    background: radial-gradient(circle at 34% 28%, #fff5d6 0%, #efd08a 16%, #c39443 50%, #8a5f24 78%, #5d3d14 100%);
    box-shadow: inset 0 0 0 2.5px rgb(255 238 196 / 0.45), inset 0 -5px 9px rgb(70 40 10 / 0.45), 0 8px 16px -6px rgb(0 0 0 / 0.6);
  }
  .badge[data-earned] .medal :global(.icon) { filter: drop-shadow(0 1px 0 rgb(255 236 190 / 0.75)) drop-shadow(0 -1px 0 rgb(60 35 8 / 0.4)); }
  .badge[data-new] .medal { animation: strike 900ms cubic-bezier(0.34, 1.56, 0.64, 1) both; }
  @keyframes strike { 0% { transform: scale(0.6) rotateY(80deg); opacity: 0; } 60% { transform: scale(1.08) rotateY(-8deg); opacity: 1; } 100% { transform: none; } }
  :global(html[data-motion='off']) .badge[data-new] .medal { animation: none; }
  .badge__title { font-size: var(--t-cap); font-weight: 700; line-height: 1.15; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .badge__state { font-size: var(--t-cap2); font-weight: 600; color: var(--label-3); font-variant-numeric: tabular-nums; }
  .badge[data-earned] .badge__state { color: var(--win); }

  /* the last games: as many as the page holds, newest first */
  .page-col > .games-box { flex: 1 1 auto; min-height: 0; padding: 0.375rem 0.5rem; overflow: hidden; }
  .games :global(li:not(.empty)) { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.125rem 0.75rem; align-items: center; padding: 0.5rem 0.5rem; }
  .games :global(li + li) { box-shadow: inset 0 0.5px 0 var(--sep); }
  .games :global(li[hidden]) { display: none; }
  .games :global(.game__who) { display: flex; align-items: center; gap: 0.625rem; min-width: 0; font-size: var(--t-sub); }
  .games :global(.game__who > span) { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }
  .games :global(.game__face) { flex: none; width: 1.75rem; height: 1.75rem; border-radius: 50%; object-fit: cover; }
  .games :global(.meta) { grid-column: 1 / -1; padding-inline-start: 2.375rem; font-size: var(--t-cap); color: var(--label-2); }
  .games :global(.res) { font-weight: 700; font-size: var(--t-cap); padding: 0.125rem 0.5rem; border-radius: 999px; background: var(--fill-2); }
  .games :global(.res[data-r='win']) { color: var(--green-ink); background: color-mix(in srgb, var(--green) 18%, transparent); }
  .games :global(.res[data-r='loss']), .games :global(.res[data-r='resigned']) { color: var(--red-ink); background: color-mix(in srgb, var(--red) 14%, transparent); }
  .games :global(.empty) { padding: 0.75rem 0.5rem; color: var(--label-2); font-size: var(--t-sub); }
  .games :global(.empty a) { color: var(--tint-ink); font-weight: 600; text-decoration: none; }

  /* a wide screen: the four pages down the side (screen--split), the chosen one at full height */
  @media (min-width: 1024px) {
    .progress { grid-template-rows: auto minmax(0, 1fr); }
    .medal { width: clamp(3.25rem, 1rem + 7dvh, 5.5rem); }
    .badge__title { font-size: var(--t-foot); }
  }
</style>
