---
import App from '../../layouts/App.astro';
import { LESSONS } from '../../data/lessons';
import { REPERTOIRES } from '../../data/repertoires';
import { icon } from '../../lib/icons';
---

<App title="Mësime · Shah" description="Mësime të shkurtra për lojtarin që di rregullat: vlera e figurave, piruni, lidhja, mati, hapja." tab="mesime">
  <div class="page lessons">
    <h1 class="page-title poster">Mësime</h1>
    <p class="lede">{LESSONS.length} mësime të shkurtra. Secili shpjegon një ide në tabelë dhe të lë ta luash vetë.</p>
    <ol class="group lessons__list">
      {LESSONS.map((l, i) => (
        <li>
          <a href={`/mesime/${l.slug}/`} class="row lesson-row" data-lesson={l.slug}>
            <span class="lesson-row__n tabular" aria-hidden="true">{i + 1}</span>
            <span class="lesson-row__body">
              <b class="lesson-row__title">{l.title}</b>
              <span class="lesson-row__lede">{l.lede}</span>
              <span class="lesson-row__meta">
                <span class="lesson-row__done" data-done hidden><Fragment set:html={icon('check')} />Kryer</span>
                <span class="lesson-row__steps">{l.steps.length} hapa</span>
              </span>
            </span>
            <span class="lesson-row__go" aria-hidden="true"><Fragment set:html={icon('caretRight')} /></span>
          </a>
        </li>
      ))}
    </ol>

    <h2 class="group-h">Trajno hapjet</h2>
    <p class="group-note">Zgjidh një repertor. Motori luan përgjigjet e kundërshtarit, ti luan lëvizjet e tua derisa t’i dish përmendsh.</p>
    <ol class="group lessons__list">
      {REPERTOIRES.map((r) => (
        <li>
          <a href={`/mesime/hapje/${r.slug}/`} class="row lesson-row" data-rep={r.slug} data-lines={r.lines.length}>
            <span class="lesson-row__n lesson-row__n--side" data-side={r.side} aria-hidden="true">{r.side === 'w' ? 'B' : 'Z'}</span>
            <span class="lesson-row__body">
              <b class="lesson-row__title">{r.title}</b>
              <span class="lesson-row__lede">{r.lede}</span>
              <span class="lesson-row__meta">
                <span class="lesson-row__steps" data-rep-state>{r.lines.length} linja</span>
              </span>
            </span>
            <span class="lesson-row__go" aria-hidden="true"><Fragment set:html={icon('caretRight')} /></span>
          </a>
        </li>
      ))}
    </ol>
  </div>
  <script>
    import { load } from '../../lib/store';
    const done = new Set(load().lessons);
    document.querySelectorAll<HTMLElement>('[data-lesson]').forEach((a) => {
      if (done.has(a.dataset.lesson!)) a.querySelector<HTMLElement>('[data-done]')!.hidden = false;
    });
    const reps = load().reps;
    document.querySelectorAll<HTMLElement>('[data-rep]').forEach((a) => {
      const n = Number(a.dataset.lines);
      const learnt = Array.from({ length: n }, (_, i) => reps[`${a.dataset.rep}:${i}`]?.streak ?? 0).filter((x) => x >= 3).length;
      a.querySelector('[data-rep-state]')!.textContent = `${learnt} nga ${n} linja të mësuara`;
    });
  </script>
</App>

<style>
  .lessons { max-width: 46rem; margin-inline: auto; }
  .lessons__list { margin-top: var(--space-s); --sep-inset: 4.125rem; }
  .lede + .lessons__list { margin-top: var(--space-m); }
  .lesson-row { grid-template-columns: 2.25rem minmax(0, 1fr) auto; gap: 0.875rem; align-items: center; padding-block: 0.75rem; }
  /* the step in the sequence on a tile, the way Settings sets its symbols */
  .lesson-row__n {
    display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 0.625rem;
    background: var(--tint-fill); color: #fff; font-weight: 700; font-size: var(--t-callout);
  }
  /* a repertoire's tile is the colour its learner plays */
  .lesson-row__n--side[data-side="w"] { background: #f2f2f7; color: #000; box-shadow: inset 0 0 0 0.5px rgb(0 0 0 / 0.2); }
  .lesson-row__n--side[data-side="b"] { background: #1c1c1e; color: #fff; box-shadow: inset 0 0 0 0.5px rgb(255 255 255 / 0.18); }
  .lesson-row__body { display: grid; gap: 0.125rem; }
  .lesson-row__title { font-weight: 600; font-size: var(--t-body); line-height: 1.25; }
  .lesson-row__lede { color: var(--label-2); font-size: var(--t-foot); line-height: 1.35; max-width: 52ch; }
  .lesson-row__meta { display: flex; flex-wrap: wrap; gap: 0.125rem 0.75rem; margin-top: 0.125rem; font-size: var(--t-cap); color: var(--label-2); }
  .lesson-row__done { display: inline-flex; align-items: center; gap: 0.25rem; color: var(--green-ink); font-weight: 600; }
  .lesson-row__done[hidden] { display: none; }
  .lesson-row__done .icon { width: 0.875rem; height: 0.875rem; }
  .lesson-row__go .icon { width: 0.875rem; height: 0.875rem; color: var(--label-3); }
</style>
