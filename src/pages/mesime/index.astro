---
import { Chess } from 'chess.js';
import App from '../../layouts/App.astro';
import { COURSE, LESSONS, lessonFen } from '../../data/lessons';
import { REPERTOIRES } from '../../data/repertoires';
import { icon } from '../../lib/icons';
import { miniBoard } from '../../lib/miniboard';

// a repertoire's diagram: its first line after three moves each, from the learner's side
const repFen = (moves: string) => {
  const c = new Chess();
  for (const m of moves.split(' ').slice(0, 6)) c.move(m);
  return c.fen();
};
let n = 0;
---

<App title="Mësime · Shah" description="Mësime të shkurtra për lojtarin që di rregullat: vlera e figurave, piruni, lidhja, mati, hapja." tab="mesime" room>
  <div class="screen screen--split course">
    <header class="screen__head">
      <div>
        <h1 class="screen__title poster">Mësime</h1>
        <p class="screen__sub"><b class="tabular" data-done-n>0</b> nga {LESSONS.length} të kryera, në {COURSE.length} kapituj</p>
      </div>
      <a class="btn btn--solid course__go" href={`/mesime/${COURSE[0].lessons[0].slug}/`} data-next-link>
        <Fragment set:html={icon('play')} /><span data-next-verb>Fillo</span>
      </a>
    </header>
    <span class="course__bar" aria-hidden="true"><span data-bar></span></span>

    <div class="pager-tabs" role="tablist" aria-label="Kapitujt" data-pager-tabs="course">
      {COURSE.map((ch, i) => (
        <button type="button" role="tab" data-pager-tab={i} aria-controls={`ch-${ch.n}`}>
          <span class="tab__n">{ch.n}</span>{ch.title}
        </button>
      ))}
      <button type="button" role="tab" data-pager-tab={COURSE.length} aria-controls="ch-reps"><Fragment set:html={icon('bookOpenText', 'icon tab__icon tab__icon--keep')} />Trajneri</button>
    </div>

    <div class="pager" data-pager="course">
      {COURSE.map((ch) => (
        <section class="pager__page" role="tabpanel" id={`ch-${ch.n}`} aria-labelledby={`ch-${ch.n}-t`}>
          <div class="chapter glass-card">
            <header class="chapter__head">
              <span class="chapter__n" aria-hidden="true">{ch.n}</span>
              <div class="chapter__words">
                <h2 class="chapter__title" id={`ch-${ch.n}-t`}><span class="visually-hidden">Kapitulli {ch.n}: </span>{ch.title}</h2>
                <p class="chapter__note">{ch.note}</p>
              </div>
              <span class="chapter__count tabular" data-chapter-count data-total={ch.lessons.length}>0/{ch.lessons.length}</span>
            </header>
            <ol class="stops stagger">
              {ch.lessons.map((l, i) => {
                n++;
                return (
                  <li class="stop" data-lesson={l.slug} style={`--i: ${i}`}>
                    <a href={`/mesime/${l.slug}/`} class="stop__link">
                      <span class="stop__board"><Fragment set:html={miniBoard(lessonFen(l))} /></span>
                      <span class="stop__body">
                        <span class="stop__k tabular">Mësimi {n} · {l.steps.length} hapa</span>
                        <b class="stop__title">{l.title}</b>
                        <span class="stop__lede">{l.lede}</span>
                      </span>
                      <span class="stop__state">
                        <span class="stop__done" data-done hidden><Fragment set:html={icon('check')} /><span class="visually-hidden">Kryer</span></span>
                        <span class="stop__next" data-next hidden>Vazhdo</span>
                        <Fragment set:html={icon('caretRight', 'icon stop__go')} />
                      </span>
                    </a>
                  </li>
                );
              })}
            </ol>
          </div>
        </section>
      ))}
      <section class="pager__page" role="tabpanel" id="ch-reps" aria-labelledby="ch-reps-t">
        <div class="chapter glass-card">
          <header class="chapter__head">
            <span class="chapter__n chapter__n--sym" aria-hidden="true"><Fragment set:html={icon('bookOpenText')} /></span>
            <div class="chapter__words">
              <h2 class="chapter__title" id="ch-reps-t">Trajno hapjet</h2>
              <p class="chapter__note">Motori luan përgjigjet, ti lëvizjet e tua, derisa t’i dish përmendsh.</p>
            </div>
          </header>
          <ol class="stops stagger">
            {REPERTOIRES.map((r, i) => (
              <li class="stop" style={`--i: ${i}`}>
                <a href={`/mesime/hapje/${r.slug}/`} class="stop__link" data-rep={r.slug} data-lines={r.lines.length}>
                  <span class="stop__board"><Fragment set:html={miniBoard(repFen(r.lines[0].moves), { side: r.side })} /></span>
                  <span class="stop__body">
                    <span class="stop__k" data-rep-state>{r.side === 'w' ? 'Me të bardhat' : 'Me të zezat'} · {r.lines.length} linja</span>
                    <b class="stop__title">{r.title.replace(/^Me të (bardhat|zezat)( kundër [^:]+)?: /, '')}</b>
                    <span class="stop__lede">{r.lede}</span>
                  </span>
                  <span class="stop__state"><Fragment set:html={icon('caretRight', 'icon stop__go')} /></span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </section>
    </div>
  </div>
  <script>
    import { COURSE, COURSE_ORDER, nextLesson } from '../../data/lessons';
    import { load } from '../../lib/store';
    import { initPagers, pagerOf } from '../../scripts/pager';

    function paint(first: boolean) {
      const p = load();
      const done = new Set(p.lessons);
      const next = nextLesson(p.lessons);
      const all = done.size >= COURSE_ORDER.length;
      document.querySelectorAll<HTMLElement>('[data-lesson]').forEach((li) => {
        const slug = li.dataset.lesson!;
        const state = done.has(slug) ? 'done' : !all && slug === next.slug ? 'next' : 'open';
        li.dataset.state = state;
        li.querySelector<HTMLElement>('[data-done]')!.hidden = state !== 'done';
        li.querySelector<HTMLElement>('[data-next]')!.hidden = state !== 'next';
      });
      document.querySelectorAll<HTMLElement>('.chapter').forEach((ch) => {
        const count = ch.querySelector<HTMLElement>('[data-chapter-count]');
        if (!count) return;
        const k = ch.querySelectorAll('[data-state="done"]').length;
        count.textContent = `${k}/${count.dataset.total}`;
        ch.toggleAttribute('data-complete', k === Number(count.dataset.total));
      });
      const k = COURSE_ORDER.filter((l) => done.has(l.slug)).length;
      document.querySelector('[data-done-n]')!.textContent = String(k);
      document.querySelector<HTMLElement>('[data-bar]')!.style.transform = `scaleX(${k / COURSE_ORDER.length})`;
      const go = document.querySelector<HTMLAnchorElement>('[data-next-link]')!;
      go.href = `/mesime/${next.slug}/`;
      document.querySelector('[data-next-verb]')!.textContent = all ? 'Përsërit' : k ? 'Vazhdo' : 'Fillo';
      go.setAttribute('aria-label', `${all ? 'Përsërit' : k ? 'Vazhdo' : 'Fillo'}: ${next.title}`);
      const reps = p.reps;
      document.querySelectorAll<HTMLElement>('[data-rep]').forEach((a) => {
        const n = Number(a.dataset.lines);
        const learnt = Array.from({ length: n }, (_, i) => reps[`${a.dataset.rep}:${i}`]?.streak ?? 0).filter((x) => x >= 3).length;
        a.querySelector('[data-rep-state]')!.textContent = `${learnt} nga ${n} linja të mësuara`;
      });
      // the course opens on the chapter of the next lesson
      if (first) {
        initPagers();
        pagerOf('course')?.go(Math.max(0, COURSE.findIndex((c) => c.lessons.includes(next))), false);
      }
    }
    paint(true);
    window.addEventListener('shah:synced', () => paint(false));
  </script>
</App>

<style>
  .course__go { flex: none; min-height: 44px; padding-inline: 1.125rem; }
  .course__go :global(.icon) { width: 1rem; height: 1rem; }
  .course__bar { display: block; height: 0.25rem; border-radius: 999px; background: var(--fill); overflow: hidden; }
  .course__bar span { display: block; height: 100%; background: linear-gradient(90deg, #c99a52, #ecd29c); transform: scaleX(0); transform-origin: left; transition: transform 700ms var(--ease-out) 200ms; }
  .tab__n { font-family: var(--font-display); font-size: 1rem; font-weight: 600; color: #e2c48c; }
  :global(html[data-world-tone='light']) .tab__n { color: #8a5a22; }
  .pager-tabs :global(.icon) { width: 1rem; height: 1rem; }

  /* a chapter is one card: its numeral, its name and its lessons, each with the diagram it opens on */
  .chapter { display: flex; flex-direction: column; height: 100%; border-radius: 1.5rem; padding: 0.875rem 0.75rem 0.5rem; }
  .chapter__head { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 0.75rem; padding: 0 0.25rem 0.625rem; }
  .chapter__n { min-width: 2.5rem; font-family: var(--font-display); font-size: 2.5rem; font-weight: 500; line-height: 0.85; color: #e2c48c; text-align: center; }
  :global(html[data-world-tone='light']) .chapter__n { color: #8a5a22; }
  .chapter__n--sym { display: grid; place-items: center; height: 2.5rem; }
  .chapter__n--sym :global(.icon) { width: 1.75rem; height: 1.75rem; }
  .chapter__title { font-family: var(--font-display); font-size: var(--t-title1); font-weight: 600; letter-spacing: -0.01em; line-height: 1.05; }
  .chapter__note { margin-top: 0.125rem; font-size: var(--t-foot); line-height: 1.3; color: var(--label-2); }
  .chapter__count { padding: 0.25rem 0.625rem; border-radius: 999px; background: var(--fill-2); font-size: var(--t-foot); font-weight: 600; color: var(--label-2); }
  .chapter[data-complete] .chapter__count { background: color-mix(in srgb, #d9b26f 26%, transparent); color: #f0d9a8; }
  :global(html[data-world-tone='light']) .chapter[data-complete] .chapter__count { color: #7a4c16; }

  /* the lessons: they share the card's height and never scroll it */
  .stops { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; justify-content: flex-start; gap: 0.25rem; }
  /* a row keeps its height: what does not fit is never squeezed into the row below (the rules under it make it fit) */
  .stop { flex: none; }
  .stop__link {
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 0.75rem;
    padding: 0.5rem 0.5rem 0.5rem 0.375rem; border-radius: 1.125rem; color: var(--label); text-decoration: none;
    transition: background-color var(--dur-ui) ease, transform var(--dur-press) var(--ease-out);
  }
  .stop__link:active { transform: scale(0.985); background: var(--glass-press); }
  @media (hover: hover) and (pointer: fine) { .stop__link:hover { background: var(--glass-press); } }
  .stop[data-state='next'] .stop__link { background: color-mix(in srgb, var(--tint) 16%, transparent); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--tint) 45%, transparent); }
  .stop__board { display: block; width: clamp(2.75rem, 1.2rem + 4.6dvh, 4rem); padding: 2px; }
  .stop__body { display: grid; gap: 0.0625rem; min-width: 0; }
  .stop__k { font-size: var(--t-cap); font-weight: 600; color: var(--label-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .stop__title { font-family: var(--font-display); font-size: var(--t-title3); font-weight: 600; line-height: 1.12; letter-spacing: -0.005em; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .stop__lede { font-size: var(--t-foot); line-height: 1.3; color: var(--label-2); display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
  .stop__state { display: inline-flex; align-items: center; gap: 0.375rem; }
  .stop__done { display: inline-grid; place-items: center; width: 1.5rem; height: 1.5rem; border-radius: 50%; background: color-mix(in srgb, #d9b26f 30%, transparent); color: #f0d9a8; }
  :global(html[data-world-tone='light']) .stop__done { color: #7a4c16; }
  .stop__done[hidden], .stop__next[hidden] { display: none; }
  .stop__done :global(.icon) { width: 0.875rem; height: 0.875rem; }
  .stop__next { padding: 0.1875rem 0.5rem; border-radius: 999px; background: var(--tint-fill); color: #fff; font-size: var(--t-cap); font-weight: 700; }
  .stop__state :global(.stop__go) { width: 0.875rem; height: 0.875rem; color: var(--label-3); }
  /* a short phone keeps the title and the diagram and lets the line under them go; a page of four or five keeps
     each title to one line */
  @media (max-height: 700px) and (max-width: 1023px) {
    .stop__lede, .chapter__note { display: none; }
    .chapter__n { font-size: 2rem; }
    .stops:has(> .stop:nth-child(4)) .stop__title { -webkit-line-clamp: 1; }
    .stop__board { width: 2.5rem; }
    .stop__link { padding-block: 0.25rem; }
  }
  /* a very short phone: on a page of four or five, the tab above already names the chapter, so the card gives its
     head to the lessons */
  @media (max-height: 640px) and (max-width: 1023px) {
    .chapter:has(.stop:nth-child(4)) .chapter__head { display: none; }
    .chapter:has(.stop:nth-child(4)) { padding-top: 0.5rem; }
    .stops { gap: 0.125rem; }
    .stop__board { width: 2.375rem; }
    .stop__link { padding-block: 0.1875rem; }
    .stops:has(> .stop:nth-child(4)) .stop__title { font-size: 1.125rem; }
    /* with larger text the five rows of the trainer need the last few pixels */
    :global(html[data-text='large']) .stops:has(> .stop:nth-child(5)) { gap: 0; }
  }

  .pager-tabs :global(.tab__icon--keep) { display: block; }
  /* a wide screen: the chapters down the side (screen--split), the chosen one tall enough for every lesson with its
     diagram and its line */
  @media (min-width: 1024px) {
    .course { grid-template-rows: auto auto minmax(0, 1fr); }
    .pager-tabs .tab__n { min-width: 1.75rem; font-size: 1.25rem; text-align: center; }
    .pager-tabs :global(.icon) { width: 1.25rem; height: 1.25rem; margin-inline: 0.25rem; }
    .chapter { padding: 1.125rem 1rem 0.75rem; }
    .stop__board { width: clamp(2.75rem, 0.5rem + 5.5dvh, 3.75rem); }
  }
</style>
