---
import '../styles/app.css';
import '../styles/feel.css';
import { icon } from '../lib/icons';
import { pieceSprite } from '../lib/chess/silhouette';

interface Props {
  title: string;
  description: string;
  tab: 'luaj' | 'ushtrime' | 'mesime' | 'analizo' | 'progresi' | null;
  /** the page is the lit table: dark studio throughout, whatever the system theme */
  stage?: boolean;
  /** a reading page that sits in the same room as the table (a still of it behind the page) */
  room?: boolean;
  /** the one kind of page that scrolls (the settings); every other page is one screen */
  scroll?: boolean;
  /** kept out of search results (the 404) */
  noindex?: boolean;
  /** the home page carries the app's structured data */
  home?: boolean;
}
const { title, description, tab, stage = false, room = false, scroll = false, noindex = false, home = false } = Astro.props;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og.png', site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Shah',
  alternateName: 'Shah: trajner shahu në shqip',
  url: new URL('/', site).href,
  description,
  inLanguage: 'sq',
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Web',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
};
const tabs = [
  { id: 'luaj', href: '/luaj/', label: 'Luaj', icon: 'horse' },
  { id: 'ushtrime', href: '/ushtrime/', label: 'Ushtrime', icon: 'puzzlePiece' },
  { id: 'mesime', href: '/mesime/', label: 'Mësime', icon: 'bookOpenText' },
  { id: 'analizo', href: '/analizo/', label: 'Analizo', icon: 'magnifyingGlass' },
  { id: 'progresi', href: '/progresi/', label: 'Progresi', icon: 'chartLineUp' },
] as const;
import LookPicker from '../components/LookPicker.astro';
---

<!doctype html>
<html lang="sq" data-motion="on" data-stage={stage ? '' : undefined} data-room={room ? '' : undefined} data-scroll={scroll ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {stage || room ? <meta name="theme-color" content={stage ? '#090d0a' : '#140d09'} /> : <meta name="theme-color" content="#f2f2f7" media="(prefers-color-scheme: light)" />}
    {!stage && !room && <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />}
    <link rel="preload" href="/fonts/bodoni-moda.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Shah" />
    <meta property="og:locale" content="sq_AL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Tabela prej druri e Shah nën një llambë, me titullin Shah." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {home && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <style is:inline>@view-transition{navigation:auto}</style>
    <script is:inline>
      // the kind of move between pages, for the view transition (styles/feel.css): deeper slides in from the right
      // (push), back slides out (pop), between tabs a quick fade (tab); with motion off there is none
      addEventListener('pagereveal', function (e) {
        var vt = e.viewTransition;
        if (!vt) return;
        try {
          if (localStorage.getItem('shah.motion') === 'off' || matchMedia('(prefers-reduced-motion: reduce)').matches) return vt.skipTransition();
          var act = window.navigation && navigation.activation;
          var from = act && act.from ? act.from.url : document.referrer;
          if (!from || new URL(from).origin !== location.origin) return;
          var depth = function (p) { return p.split('/').filter(Boolean).length; };
          var a = depth(new URL(from).pathname);
          var b = depth(location.pathname);
          var kind = b > a ? 'push' : b < a ? 'pop' : 'tab';
          if (vt.types) vt.types.add(kind);
        } catch (err) {}
      });
    </script>
    <script is:inline>
      try {
        if (localStorage.getItem('shah.motion') === 'off') document.documentElement.dataset.motion = 'off';
        var g = parseFloat(localStorage.getItem('shah.glass'));
        if (g >= 0 && g <= 1) document.documentElement.style.setProperty('--glass-level', String(g));
        if (localStorage.getItem('shah.text') === 'large') document.documentElement.dataset.text = 'large';
        // the room (the reading pages show a still of it) and the bright room's light glass, before the page paints
        // (looks.ts keeps both in step afterwards)
        var world = localStorage.getItem('shah.world');
        if (world === 'day' || world === 'fire' || world === 'night') document.documentElement.dataset.world = world;
        if (world === 'day') document.documentElement.dataset.worldTone = 'light';
      } catch (e) {}
    </script>
  </head>
  <body>
    {room && <div class="room-bg" aria-hidden="true"></div>}
    <a class="skip-link" href="#main">Kalo te përmbajtja</a>
    <Fragment set:html={pieceSprite()} />
    <header class="mast">
      <a class="mast__mark" href="/" translate="no" aria-label="Shah, faqja kryesore">Shah</a>
      {room && <span class="mast__title" aria-hidden="true">{title.split(' · ')[0]}</span>}
      <nav class="mast__nav" aria-label="Kryesore">
        {tabs.map((t) => (
          <a href={t.href} aria-current={tab === t.id ? 'page' : undefined}>
            {tab === t.id && <span class="tabs__lens" aria-hidden="true" />}
            <Fragment set:html={icon(t.icon)} />
            <span class="tabs__label">{t.label}</span>
          </a>
        ))}
      </nav>
      <button class="motion-switch" type="button" data-motion-switch aria-pressed="false">
        <span data-when="on"><Fragment set:html={icon('pause')} /><span class="motion-switch__label">Ndal animacionet</span></span>
        <span data-when="off"><Fragment set:html={icon('play')} /><span class="motion-switch__label">Animacionet të ndalura</span></span>
      </button>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {stage && <LookPicker sheet />}
    <nav class="tabs" aria-label="Kryesore">
      {tabs.map((t) => (
        <a href={t.href} aria-current={tab === t.id ? 'page' : undefined}>
          {tab === t.id && <span class="tabs__lens" aria-hidden="true" />}
          <Fragment set:html={icon(t.icon)} />
          <span class="tabs__label">{t.label}</span>
        </a>
      ))}
    </nav>
    <script>
      import { initShell } from '../scripts/shell';
      import { initFeel } from '../scripts/feel';
      import { initPanels } from '../scripts/panel';
      import { initPagers } from '../scripts/pager';
      initShell();
      initFeel();
      initPanels();
      initPagers();
    </script>
    {import.meta.env.PROD && (
      <script is:inline>
        if ('serviceWorker' in navigator) addEventListener('load', function () { navigator.serviceWorker.register('/sw.js').catch(function () {}); });
      </script>
    )}
  </body>
</html>
