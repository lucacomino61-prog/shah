---
import '@fontsource-variable/mona-sans/standard.css';
import fontUrl from '@fontsource-variable/mona-sans/files/mona-sans-latin-standard-normal.woff2?url';
import '../styles/app.css';
import { icon } from '../lib/icons';
import { pieceSprite } from '../lib/chess/silhouette';

interface Props {
  title: string;
  description: string;
  tab: 'luaj' | 'ushtrime' | 'mesime' | 'progresi' | null;
  /** the page is the lit table: dark studio throughout, whatever the system theme */
  stage?: boolean;
}
const { title, description, tab, stage = false } = Astro.props;
const tabs = [
  { id: 'luaj', href: '/luaj/', label: 'Luaj', icon: 'horse' },
  { id: 'ushtrime', href: '/ushtrime/', label: 'Ushtrime', icon: 'puzzlePiece' },
  { id: 'mesime', href: '/mesime/', label: 'Mësime', icon: 'bookOpenText' },
  { id: 'progresi', href: '/progresi/', label: 'Progresi', icon: 'chartLineUp' },
] as const;
---

<!doctype html>
<html lang="sq" data-motion="on" data-stage={stage ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#e6e5e1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111214" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <style is:inline>@view-transition{navigation:auto}</style>
    <script is:inline>
      try {
        if (localStorage.getItem('shah.motion') === 'off') document.documentElement.dataset.motion = 'off';
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Kalo te përmbajtja</a>
    <Fragment set:html={pieceSprite()} />
    <header class="mast">
      <a class="mast__mark" href="/" translate="no" aria-label="Shah, faqja kryesore">Shah</a>
      <nav class="mast__nav" aria-label="Kryesore">
        {tabs.map((t) => (
          <a href={t.href} aria-current={tab === t.id ? 'page' : undefined}>
            <Fragment set:html={icon(t.icon)} />
            {t.label}
          </a>
        ))}
      </nav>
      <button class="motion-switch" type="button" data-motion-switch aria-pressed="false">
        <span data-when="on"><Fragment set:html={icon('pause')} />Ndal lëvizjet</span>
        <span data-when="off"><Fragment set:html={icon('play')} />Lëvizjet të ndalura</span>
      </button>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <nav class="tabs" aria-label="Kryesore">
      {tabs.map((t) => (
        <a href={t.href} aria-current={tab === t.id ? 'page' : undefined}>
          <Fragment set:html={icon(t.icon)} />
          {t.label}
        </a>
      ))}
    </nav>
    <script>
      import { initShell } from '../scripts/shell';
      initShell();
    </script>
  </body>
</html>
